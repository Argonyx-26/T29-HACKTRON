<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070709" />
    <meta name="description" content="Knowledge Twin builds a living model of student understanding with adaptive learning and cognitive diagnostics." />
    <title>Knowledge Twin - AI Learning and Cognitive Diagnostics</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            },
            colors: {
              brand: {
                black: '#050505',
                dark: '#08070b',
                card: '#0d0d0e',
                border: 'rgba(255, 255, 255, 0.06)',
                borderHover: '#2d2a3b',
                primary: '#6800CB',
                neon: '#8b2cf5',
                accent: '#a855f7',
                muted: '#71707d',
                lightMuted: '#9e9da8'
              },
              surface: '#050505',
              'surface-container-lowest': '#050505',
              'surface-container-low': '#0d0d0e',
              'surface-container': '#121214',
              'surface-container-high': '#18181c',
              'surface-container-highest': '#202026',
              'on-surface': '#e5e2e1',
              'on-surface-variant': '#cdc2d7',
              primary: '#d7baff',
              'primary-container': '#6800cb',
              'on-primary': '#440088',
              'on-primary-container': '#cfaeff',
              secondary: '#e0b6ff',
              'secondary-container': '#6d11ad',
              tertiary: '#4edea3',
              'tertiary-container': '#00583b',
              error: '#ffb4ab',
              'error-container': '#93000a',
              outline: '#978da0',
              'outline-variant': '#4b4455'
            }
          }
        }
      }
    </script>
  </head>
  <body class="bg-[#000000] text-[#e5e2e1] antialiased" style="background-color: #000000 !important;">
    <div id="root"></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
