:root {
  --bg-primary: #070709;
  --bg-secondary: #09090c;
  --bg-card: #0d0d12;
  --bg-card-hover: #14141e;
  
  --border-subtle: rgba(255, 255, 255, 0.07);
  --border-medium: rgba(255, 255, 255, 0.12);
  --border-accent: rgba(104, 0, 203, 0.4);
  
  --text-primary: #FFFFFF;
  --text-secondary: #cdc2d7;
  --text-muted: #9496a8;
  
  --purple-primary: #6800cb;
  --purple-neon: #9333ea;
  --purple-hover: #7b14e3;
  --purple-light: rgba(104, 0, 203, 0.2);
  --purple-lavender: #d7baff;
  --secondary: #e0b6ff;
  
  --emerald-mastery: #4edea3;
  --emerald-light: rgba(78, 222, 163, 0.15);
  
  --amber-warning: #f59e0b;
  --amber-light: rgba(245, 158, 11, 0.15);
  
  --rose-error: #ffb4ab;
  --rose-light: rgba(255, 180, 171, 0.15);
  
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-heading: 'Plus Jakarta Sans', sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 20px rgba(0, 0, 0, 0.6);
  --shadow-purple: 0 0 25px -4px rgba(104, 0, 203, 0.65);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: var(--bg-primary) !important;
  color: #e5e2e1;
  font-family: var(--font-sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  min-height: 100vh;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  letter-spacing: -0.02em;
  color: #FFFFFF;
}

/* Glassmorphism Card Utility */
.card-panel {
  background: #0d0d12;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: var(--radius-lg);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.5);
  transition: all 0.2s ease;
}

.card-panel:hover {
  border-color: rgba(147, 51, 234, 0.28);
  box-shadow: 0 8px 32px -4px rgba(104, 0, 203, 0.2);
}

/* Shared application frame, aligned with the supplied Stitch references. */
.app-sidebar {
  background: #060608 !important;
  border-right-color: rgba(255, 255, 255, 0.07) !important;
}

.sidebar-nav-button {
  border: 1px solid transparent !important;
}

.sidebar-nav-button.is-active {
  background: linear-gradient(100deg, rgba(104, 0, 203, 0.96), rgba(76, 5, 135, 0.88)) !important;
  border-color: rgba(147, 51, 234, 0.38) !important;
  box-shadow: 0 0 22px rgba(104, 0, 203, 0.23) !important;
}

.app-main {
  padding-bottom: 36px !important;
}

.app-workspace > footer {
  background: #060608 !important;
  border-top-color: rgba(255, 255, 255, 0.07) !important;
}

/* Student learning space dashboard from the supplied screen reference. */
.learning-home { color: #e8e6ef; }
.learning-topbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: -8px 0 38px; }
.learning-search { width: min(560px, 75%); height: 42px; display: flex; align-items: center; gap: 12px; padding: 0 16px; border: 1px solid #292833; border-radius: 999px; background: #0b0b10; color: #a6a3b5; }
.learning-search input { flex: 1; min-width: 0; padding: 0 !important; border: 0 !important; outline: 0 !important; background: transparent !important; color: #e8e6ef !important; box-shadow: none !important; font-size: 13px !important; }
.learning-search input::placeholder { color: #aaa7b6; }
.learning-search kbd { color: #777485; font-size: 11px; }
.learning-notifications { position: relative; display: grid; place-items: center; width: 38px; height: 38px; border: 0; background: transparent; color: #aaa6bb; cursor: pointer; }
.learning-notifications i { position: absolute; top: 6px; right: 7px; width: 7px; height: 7px; border-radius: 50%; background: #9333ea; box-shadow: 0 0 10px #9333ea; }
.learning-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 22px; }
.learning-eyebrow, .dashboard-kicker { display: block; color: #b8b1ca; font-size: 11px; font-weight: 700; letter-spacing: .16em; }
.learning-heading h1 { margin: 10px 0 3px; color: #fff; font-size: clamp(32px, 3.5vw, 52px); font-weight: 800; line-height: 1.1; letter-spacing: -.045em; }
.learning-heading h1 span { background: linear-gradient(100deg, #b74bff, #6815eb); color: transparent; background-clip: text; }
.learning-heading p, .learning-section-heading p { color: #a6a3b5; font-size: 15px; }
.learning-heading blockquote { margin: 0 4% 2px 0; color: #a9a6b7; font: italic 20px/1.35 Georgia, serif; text-align: center; }
.learning-layout { display: grid; grid-template-columns: minmax(0, 1fr) 290px; align-items: start; gap: 18px; }
.learning-main-column, .learning-side-column { display: flex; min-width: 0; flex-direction: column; gap: 22px; }
.continue-card, .focus-card, .learning-quote-card, .quick-actions-card, .learning-promo-card, .evidence-card, .recommendation-tile { border: 1px solid #23222d; border-radius: 13px; background: linear-gradient(145deg, #0b0b10, #0c0c12); }
.continue-card { position: relative; display: flex; min-height: 250px; overflow: hidden; }
.continue-copy { position: relative; z-index: 1; width: 64%; padding: 24px 26px; }
.continue-copy h2 { margin: 12px 0 20px; color: #f6f4fa; font-size: clamp(21px, 2vw, 28px); letter-spacing: -.03em; }
.continue-current { display: flex; align-items: center; gap: 15px; }
.continue-book-icon, .evidence-icon { flex: 0 0 auto; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; border: 1px solid rgba(157, 78, 221, .22); background: rgba(104, 0, 203, .16); color: #b555ff; }
.continue-current small, .continue-current strong, .continue-current p { display: block; }
.continue-current small { color: #aaa7b8; font-size: 12px; }
.continue-current strong { margin-top: 2px; color: #f4f1fa; font-size: 16px; }
.continue-current p { margin-top: 6px; color: #9996a8; font-size: 12px; }
.continue-actions { display: flex; gap: 12px; margin-top: 24px; }
.learning-primary, .learning-secondary { display: inline-flex; min-height: 40px; align-items: center; justify-content: center; gap: 8px; padding: 0 19px; border-radius: 9px; cursor: pointer; font: 600 13px var(--font-sans); }
.learning-primary { border: 1px solid #8427e8; background: linear-gradient(100deg, #7500e9, #8d2eea); color: white; box-shadow: 0 5px 18px rgba(104, 0, 203, .25); }
.learning-primary:hover { filter: brightness(1.12); }
.learning-secondary { border: 1px solid #454351; background: rgba(5, 5, 9, .5); color: #dad7e3; }
.continue-art { position: absolute; inset: 0 0 0 auto; width: 46%; background: linear-gradient(90deg, #0b0b10 0%, rgba(11,11,16,.16) 45%, rgba(11,11,16,.02) 100%), url('/neon-reader.png') center 38% / cover no-repeat; opacity: .83; mask-image: linear-gradient(90deg, transparent 0%, black 24%); }
.learning-section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; }
.learning-section-heading h2, .focus-card h2, .quick-actions-card h2 { margin: 0 0 3px; color: #f2f0f7; font-size: 20px; letter-spacing: -.025em; }
.learning-section-heading p { font-size: 13px; }
.learning-link { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6px; border: 0; background: transparent; color: #b847ff; cursor: pointer; font: 600 12px var(--font-sans); }
.twin-evidence-grid, .recommendation-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 13px; }
.evidence-card { display: flex; min-height: 112px; gap: 13px; padding: 15px; }
.evidence-card .evidence-icon { width: 42px; height: 44px; }
.evidence-card small { display: block; margin: 1px 0 5px; color: #b5b0c3; font-size: 10px; letter-spacing: .04em; }
.evidence-card strong { display: block; color: #bd63ff; font-size: 15px; }
.evidence-card p { margin-top: 5px; color: #9b98a9; font-size: 11px; line-height: 1.4; }
.recommendation-tile { position: relative; display: flex; min-height: 102px; align-items: flex-start; gap: 12px; padding: 15px 30px 15px 14px; text-align: left; color: inherit; cursor: pointer; }
.recommendation-tile:hover, .quick-actions-card button:hover { border-color: rgba(157, 78, 221, .48); background-color: #111019; }
.recommendation-tile .evidence-icon { width: 42px; height: 42px; }
.recommendation-tile strong, .recommendation-tile small { display: block; }
.recommendation-tile strong { margin: 3px 0 6px; color: #eeecf4; font-size: 13px; }
.recommendation-tile small { color: #9b98a9; font-size: 11px; line-height: 1.45; }
.tile-arrow { position: absolute; top: 43px; right: 12px; color: #b5b1c0; }
.learning-side-column { gap: 14px; }
.focus-card { padding: 19px 20px; }
.focus-card h2, .quick-actions-card h2 { font-size: 18px; }
.focus-content { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-top: 18px; }
.focus-donut { --focus-value: 0%; display: grid; flex: 0 0 auto; place-items: center; width: 112px; height: 112px; border-radius: 50%; background: conic-gradient(#7a14ed var(--focus-value), #282634 var(--focus-value)); }
.focus-donut::before { position: absolute; width: 90px; height: 90px; border-radius: 50%; background: #0b0b10; content: ''; }
.focus-donut > span { position: relative; display: flex; flex-direction: column; align-items: center; }
.focus-donut strong { color: #bf69ff; font-size: 25px; line-height: 1.1; }
.focus-donut small { color: #b1adbd; font-size: 11px; }
.focus-content ul { display: flex; flex-direction: column; gap: 14px; margin: 0; padding: 0; list-style: none; color: #b5b1c0; font-size: 12px; }
.focus-content li { display: flex; align-items: center; gap: 9px; white-space: nowrap; }
.focus-dot { width: 8px; height: 8px; border-radius: 50%; background: #8500e8; }
.focus-dot.violet { background: #6920b5; }.focus-dot.muted { background: #858194; }
.learning-quote-card { min-height: 102px; padding: 18px 22px; background: radial-gradient(ellipse at 90% 110%, rgba(61, 10, 125, .25), transparent 60%), #0d0b16; }
.learning-quote-card p { margin: 0; color: #c4bfd0; font: italic 17px/1.4 Georgia, serif; }
.learning-quote-card span, .learning-promo-card i { display: block; width: 47px; height: 3px; margin-top: 14px; background: #9c27ff; }
.quick-actions-card { padding: 17px 15px 13px; }
.quick-actions-card h2 { margin: 0 4px 12px; }
.quick-actions-card button { display: flex; width: 100%; min-height: 44px; align-items: center; gap: 10px; margin-top: 6px; padding: 0 10px; border: 1px solid #292733; border-radius: 9px; background: #0b0b10; color: #e1dee8; cursor: pointer; text-align: left; font: 500 12px var(--font-sans); }
.quick-actions-card button svg:first-child { color: #b7b2c5; }.quick-actions-card button svg:last-child { margin-left: auto; color: #a4a0b0; }
.learning-promo-card { position: relative; min-height: 108px; overflow: hidden; padding: 22px; background: radial-gradient(ellipse at 80% 120%, rgba(89, 10, 182, .48), transparent 58%), #0b0913; }
.learning-promo-card span { position: relative; z-index: 1; color: #f0edf6; font-size: 17px; line-height: 1.45; }
.learning-promo-card i { position: absolute; right: 12px; bottom: 20px; width: 90px; height: 35px; border-top: 1px solid rgba(159, 77, 236, .45); transform: skewY(-17deg); opacity: .65; }

@media (max-width: 760px) {
  .learning-topbar { margin: -2px 0 26px; }
  .learning-search { width: calc(100% - 52px); }
  .learning-search kbd, .learning-heading blockquote { display: none; }
  .learning-heading { align-items: flex-start; margin-bottom: 18px; }
  .learning-layout { grid-template-columns: minmax(0, 1fr); }
  .learning-side-column { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .continue-copy { width: 100%; padding: 21px 18px; }
  .continue-card { min-height: 290px; }
  .continue-art { width: 64%; top: auto; height: 145px; opacity: .52; }
  .continue-current { max-width: 90%; }
  .continue-current p { max-width: 230px; }
  .continue-actions { position: relative; z-index: 2; margin-top: 18px; }
  .twin-evidence-grid, .recommendation-grid { grid-template-columns: 1fr; }
  .evidence-card { min-height: 88px; }
  .learning-promo-card { min-height: 100%; }
}

@media (max-width: 440px) {
  .learning-side-column { display: flex; }
  .focus-content { justify-content: flex-start; gap: 24px; }
  .learning-heading h1 { font-size: 34px; }
  .learning-heading p { font-size: 13px; }
  .continue-actions { gap: 8px; }
  .learning-primary, .learning-secondary { padding: 0 12px; font-size: 12px; }
}

/* Tactile, luminous button and tab states. */
button { -webkit-tap-highlight-color: transparent; }
button:focus-visible { outline: 2px solid #c18aff !important; outline-offset: 3px; }
.sidebar-nav-button,
.learning-primary,
.learning-secondary,
.learning-link,
.learning-notifications,
.quick-actions-card button,
.recommendation-tile,
.dashboard-text-link,
.dashboard-primary-button,
.dashboard-ghost-button,
.btn,
.teacher-tabs button {
  transition: transform 220ms cubic-bezier(.2,.8,.2,1), box-shadow 220ms ease, border-color 220ms ease, background-color 220ms ease, color 180ms ease, filter 220ms ease !important;
}

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .sidebar-nav-button:hover,
  .teacher-tabs button:hover,
  .learning-primary:hover,
  .learning-secondary:hover,
  .dashboard-primary-button:hover,
  .dashboard-ghost-button:hover,
  .btn:hover { transform: translateY(-2px); }

  .learning-primary:hover,
  .dashboard-primary-button:hover,
  .btn-primary:hover { box-shadow: 0 8px 28px rgba(126, 25, 225, .42), 0 0 0 1px rgba(202, 155, 255, .18); filter: brightness(1.1); }

  .learning-secondary:hover,
  .dashboard-ghost-button:hover { border-color: rgba(183, 92, 255, .65); background-color: rgba(111, 35, 178, .12); box-shadow: 0 5px 18px rgba(88, 30, 145, .16); }

  .sidebar-nav-button:not(.is-active):hover { background: rgba(255,255,255,.055) !important; color: #fff !important; }
  .sidebar-nav-button.is-active:hover { box-shadow: 0 7px 26px rgba(111, 18, 224, .4), inset 0 0 0 1px rgba(220, 179, 255, .24) !important; filter: brightness(1.12); }
  .teacher-tabs button:hover { color: #fff; background-color: rgba(255,255,255,.07); }
  .teacher-tabs button[class*="bg-primary"]:hover { box-shadow: 0 0 20px rgba(215,186,255,.48); filter: brightness(1.08); }
  .learning-link:hover, .dashboard-text-link:hover { color: #d5a1ff; transform: translateX(2px); }
  .learning-link svg, .dashboard-text-link svg { transition: transform 220ms ease; }
  .learning-link:hover svg, .dashboard-text-link:hover svg { transform: translateX(3px); }
  .learning-notifications:hover { color: #dfc5ff; transform: translateY(-2px) rotate(-5deg); filter: drop-shadow(0 0 9px rgba(174,78,255,.75)); }
  .learning-notifications i { transition: transform 220ms ease, box-shadow 220ms ease; }
  .learning-notifications:hover i { transform: scale(1.35); box-shadow: 0 0 14px #a64dff; }
  .quick-actions-card button:hover { transform: translateY(-2px); box-shadow: 0 7px 18px rgba(80, 34, 126, .18); }
  .quick-actions-card button svg:last-child { transition: transform 220ms ease, color 220ms ease; }
  .quick-actions-card button:hover svg:last-child { transform: translateX(4px); color: #c88aff; }
  .recommendation-tile:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(73, 26, 120, .25), inset 0 1px rgba(200, 150, 255, .12); }
  .recommendation-tile .evidence-icon { transition: transform 280ms cubic-bezier(.2,.8,.2,1), box-shadow 220ms ease; }
  .recommendation-tile:hover .evidence-icon { transform: scale(1.08) rotate(-4deg); box-shadow: 0 0 20px rgba(148, 49, 237, .28); }
}

.sidebar-nav-button:active,
.teacher-tabs button:active,
.learning-primary:active,
.learning-secondary:active,
.learning-link:active,
.quick-actions-card button:active,
.recommendation-tile:active,
.btn:active { transform: translateY(1px) scale(.985); }

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}

/* Landing page rebuilt to match the supplied Knowledge Twin hero reference. */
.landing-viewport { min-height: 100vh; padding: 0 24px; background: #201e20; color: #f8f7fa; }
.landing-frame { min-height: 100vh; border: 1px solid #2b2930; background: #050505; }
.landing-header { height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 0 42px 0 22px; border-bottom: 1px solid #211f25; }
.landing-brand { display: flex; width: 270px; height: 52px; align-items: center; overflow: hidden; }
.landing-brand img { display: block; width: 100%; height: 100%; object-fit: contain; object-position: left center; }
.landing-actions { display: flex; align-items: center; gap: 15px; }
.landing-actions button { cursor: pointer; font: 500 12px var(--font-sans); }
.landing-login { border: 0; background: transparent; color: #e6e3e9; }
.landing-get-started { padding: 7px 12px; border: 1px solid #e9e7eb; border-radius: 5px; background: #f8f7f8; color: #151419; font-weight: 700 !important; }
.landing-hero { width: min(930px, calc(100% - 70px)); min-height: calc(100vh - 60px); display: grid; grid-template-columns: minmax(0, .96fr) minmax(0, 1.08fr); align-items: center; gap: 28px; margin: 0 auto; padding: 42px 0 48px; }
.landing-art-wrap { width: 100%; aspect-ratio: 1.15; overflow: hidden; background: #030303; }
.landing-art { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: grayscale(1) brightness(.86); }
.landing-copy { min-width: 0; padding: 0 0 2px; }
.landing-title { margin: 0; color: #f8f7fa; font-size: clamp(34px, 4.15vw, 48px); font-weight: 800; line-height: 1.16; letter-spacing: -.045em; }
.landing-line { display: block; opacity: 0; transform: translateY(13px); animation: landingLineEnter .62s cubic-bezier(.2,.75,.25,1) forwards; }
.landing-line.line-one { animation-delay: .18s; }
.landing-line.line-two { animation-delay: .68s; }
.landing-line.line-three { animation-delay: 1.18s; }
.landing-line.line-four { animation-delay: 1.68s; }
.landing-accent { color: #7800e8; }
.landing-description { max-width: 470px; margin: 18px 0 34px; color: #a9a7ac; font-size: 14px; line-height: 1.55; opacity: 0; animation: landingContentEnter .7s ease 2.08s forwards; }
.landing-hero-actions { display: flex; flex-wrap: wrap; gap: 12px; opacity: 0; animation: landingContentEnter .7s ease 2.3s forwards; }
.landing-primary-cta, .landing-secondary-cta { min-height: 38px; padding: 0 20px; border-radius: 5px; cursor: pointer; font: 700 11px var(--font-sans); letter-spacing: .01em; text-transform: uppercase; transition: transform 220ms cubic-bezier(.2,.8,.2,1), box-shadow 220ms ease, border-color 220ms ease, background 220ms ease, color 180ms ease !important; }
.landing-primary-cta { border: 1px solid #7900e8; background: #7100dc; color: #fff; }
.landing-secondary-cta { border: 1px solid #aaa7af; background: transparent; color: #f2f0f3; }
@keyframes landingLineEnter { to { opacity: 1; transform: translateY(0); } }
@keyframes landingContentEnter { to { opacity: 1; transform: translateY(0); } }

@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .landing-login:hover { color: #c987ff; }
  .landing-get-started:hover { transform: translateY(-2px); box-shadow: 0 7px 19px rgba(157, 78, 221, .25); }
  .landing-primary-cta:hover { transform: translateY(-2px); background: #8a16f5; box-shadow: 0 8px 25px rgba(111, 0, 220, .38); }
  .landing-secondary-cta:hover { transform: translateY(-2px); border-color: #bd7aff; background: rgba(117, 0, 220, .1); box-shadow: 0 7px 20px rgba(86, 32, 128, .2); }
}
.landing-actions button:active, .landing-hero-actions button:active { transform: translateY(1px) scale(.98); }

@media (max-width: 760px) {
  .landing-viewport { padding: 0 10px; }
  .landing-header { height: 58px; padding: 0 12px; }
  .landing-brand { width: 200px; height: 44px; }
  .landing-actions { gap: 10px; }
  .landing-hero { width: min(520px, calc(100% - 28px)); min-height: auto; grid-template-columns: 1fr; gap: 26px; padding: 28px 0 52px; }
  .landing-art-wrap { width: min(100%, 420px); aspect-ratio: 1.36; margin: 0 auto; }
  .landing-title { font-size: clamp(34px, 8vw, 48px); }
  .landing-description { margin: 16px 0 24px; }
}

@media (prefers-reduced-motion: reduce) {
  .landing-line, .landing-description, .landing-hero-actions { opacity: 1; transform: none; animation: none; }
}

/* Long-form landing page sections and fitted wordmark. */
.landing-header { position: sticky; top: 0; z-index: 30; background: rgba(5, 5, 5, .94); backdrop-filter: blur(16px); }
.landing-brand { width: 320px; height: 56px; }
.landing-brand img { object-fit: cover; object-position: center; mix-blend-mode: screen; }
.landing-section-nav { display: flex; align-items: center; gap: clamp(18px, 3vw, 42px); }
.landing-section-nav a { color: #aaa7b1; font-size: 12px; text-decoration: none; transition: color 180ms ease; }
.landing-section-nav a:hover { color: #fff; }
.landing-hero { min-height: max(490px, calc(100svh - 62px)); }
.landing-section, .landing-outcomes-section { width: min(1010px, calc(100% - 72px)); margin: 0 auto; scroll-margin-top: 86px; }
.landing-section { padding: 98px 0 104px; border-top: 1px solid #211f25; }
.landing-section-heading { max-width: 620px; margin: 0 auto 36px; text-align: center; }
.landing-section-eyebrow { color: #ad69eb; font-size: 10px; font-weight: 700; letter-spacing: .16em; }
.landing-section-heading h2, .landing-outcomes-copy h2 { margin: 12px 0; color: #f6f3fa; font-size: clamp(30px, 4vw, 42px); line-height: 1.12; letter-spacing: -.04em; }
.landing-section-heading h2 span, .landing-outcomes-copy h2 span { color: #9c42ed; }
.landing-section-heading > p, .landing-outcomes-copy > p { max-width: 570px; margin: 0 auto; color: #a29faa; font-size: 14px; line-height: 1.65; }
.landing-step-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
.landing-info-card { min-height: 220px; padding: 24px; border: 1px solid #25232d; border-radius: 12px; background: linear-gradient(155deg, #0e0d13, #09090d 75%); transition: transform 260ms ease, border-color 260ms ease, box-shadow 260ms ease; }
.landing-info-card:hover { transform: translateY(-5px); border-color: rgba(157, 78, 221, .55); box-shadow: 0 16px 42px rgba(62, 22, 105, .2); }
.landing-info-icon { display: grid; width: 42px; height: 42px; place-items: center; margin-bottom: 18px; border: 1px solid rgba(157, 78, 221, .32); border-radius: 11px; background: rgba(104, 0, 203, .15); color: #bc78f2; }
.landing-info-card > small { color: #9b93a8; font-size: 9px; font-weight: 700; letter-spacing: .15em; }
.landing-info-card h3 { margin: 9px 0 8px; color: #f2eff7; font-size: 17px; }
.landing-info-card p { color: #9f9ba9; font-size: 12px; line-height: 1.65; }
.landing-outcomes-section { display: grid; grid-template-columns: 1fr .92fr; align-items: center; gap: 60px; padding: 86px 0 100px; border-top: 1px solid #211f25; }
.landing-outcomes-copy h2 { font-size: clamp(32px, 4vw, 46px); }
.landing-outcomes-copy > p { margin: 0; }
.landing-inline-link { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; border: 0; background: none; color: #c078ff; cursor: pointer; font: 600 13px var(--font-sans); }
.landing-inline-link svg { transition: transform 200ms ease; }
.landing-inline-link:hover svg { transform: translateX(4px); }
.landing-twin-visual { position: relative; display: grid; min-height: 320px; place-items: center; overflow: hidden; border: 1px solid #24212d; border-radius: 18px; background: radial-gradient(ellipse at center, rgba(93, 27, 152, .2), transparent 63%), #08080c; }
.twin-orbit { position: absolute; width: 210px; height: 210px; border: 1px solid rgba(155, 72, 226, .36); border-radius: 50%; }
.orbit-two { width: 270px; height: 270px; border-color: rgba(155, 72, 226, .16); }
.twin-core { position: relative; z-index: 1; display: flex; width: 130px; height: 130px; flex-direction: column; align-items: center; justify-content: center; gap: 4px; border: 1px solid rgba(174, 102, 245, .42); border-radius: 50%; background: radial-gradient(circle, #20112f, #0c0911 70%); color: #c37aff; box-shadow: 0 0 50px rgba(104, 0, 203, .23); }
.twin-core strong { color: #f1e8fb; font-size: 13px; }.twin-core small { color: #9891a3; font-size: 9px; }
.twin-skill { position: absolute; display: flex; align-items: center; gap: 7px; padding: 9px 12px; border: 1px solid #30243b; border-radius: 9px; background: rgba(12, 10, 17, .92); color: #d4c9df; font-size: 10px; box-shadow: 0 8px 26px rgba(0,0,0,.3); }
.twin-skill svg { color: #b267f2; }.skill-one { top: 14%; left: 8%; }.skill-two { right: 7%; top: 43%; }.skill-three { left: 12%; bottom: 13%; }
.landing-curriculum-section { padding-bottom: 78px; }
.landing-curriculum-heading { display: flex; max-width: none; align-items: flex-end; justify-content: space-between; gap: 32px; text-align: left; }
.landing-curriculum-heading > div { flex: 1; }.landing-curriculum-heading h2 { margin-bottom: 0; }
.landing-curriculum-heading > p { max-width: 360px; margin: 0 0 5px; }
.landing-subject-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
.landing-subject-grid button { position: relative; display: flex; min-height: 164px; flex-direction: column; align-items: flex-start; padding: 21px 42px 20px 20px; border: 1px solid #26242e; border-radius: 11px; background: #0c0b10; color: #efedf4; cursor: pointer; text-align: left; transition: transform 220ms ease, border-color 220ms ease, background 220ms ease; }
.landing-subject-grid button:hover { transform: translateY(-3px); border-color: rgba(157,78,221,.52); background: #100d17; }
.landing-subject-grid button > span { color: #a75de5; font-size: 9px; font-weight: 700; letter-spacing: .13em; }
.landing-subject-grid strong { margin: 11px 0 7px; font-size: 15px; }.landing-subject-grid small { color: #9c98a6; font-size: 11px; line-height: 1.5; }
.landing-subject-grid button > svg { position: absolute; top: 20px; right: 17px; color: #bd7bf5; transition: transform 200ms ease; }
.landing-subject-grid button:hover > svg { transform: translateX(4px); }
.landing-bottom-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 52px; padding: 24px 26px; border: 1px solid rgba(142, 57, 219, .38); border-radius: 12px; background: radial-gradient(ellipse at 90% 100%, rgba(104,0,203,.22), transparent 50%), #0b0910; }
.landing-bottom-cta h2 { margin: 7px 0 0; color: #f5f2f8; font-size: 20px; }
.landing-bottom-cta .landing-primary-cta { display: inline-flex; align-items: center; gap: 8px; flex: 0 0 auto; }
.landing-footer { display: flex; min-height: 66px; align-items: center; justify-content: space-between; gap: 20px; padding: 0 max(28px, calc((100% - 1010px) / 2)); border-top: 1px solid #211f25; color: #817d8a; font-size: 11px; }
.landing-footer-brand { color: #e8e4ed; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-decoration: none; }.landing-footer-brand span { color: #a54df0; }
.landing-footer-brand img { display: block; width: 190px; height: 46px; object-fit: cover; object-position: center; mix-blend-mode: screen; }
.landing-footer button { border: 0; background: none; color: #aaa5b4; cursor: pointer; font: inherit; }

@media (max-width: 760px) {
  .landing-header { justify-content: space-between; }
  .landing-brand { width: 230px; height: 48px; }
  .landing-section-nav { display: none; }
  .landing-hero { width: min(520px, calc(100% - 28px)); min-height: auto; }
  .landing-section, .landing-outcomes-section { width: min(520px, calc(100% - 36px)); }
  .landing-section { padding: 70px 0; }
  .landing-step-grid, .landing-subject-grid { grid-template-columns: 1fr; }
  .landing-info-card { min-height: 0; }
  .landing-outcomes-section { grid-template-columns: 1fr; gap: 30px; padding: 70px 0; }
  .landing-twin-visual { min-height: 280px; }
  .landing-curriculum-heading { display: block; text-align: center; }
  .landing-curriculum-heading > p { margin: 16px auto 0; }
  .landing-bottom-cta { align-items: flex-start; flex-direction: column; margin-top: 34px; }
  .landing-footer { flex-wrap: wrap; justify-content: center; padding: 18px; text-align: center; }
}

@media (max-width: 430px) {
  .landing-viewport { padding: 0; }
  .landing-frame { border-left: 0; border-right: 0; }
  .landing-header { padding: 0 8px; }
  .landing-brand { width: 195px; height: 43px; }
  .landing-actions { gap: 8px; }
  .landing-get-started { padding: 7px 9px; }
  .landing-hero { width: calc(100% - 36px); padding-top: 20px; }
  .landing-hero-actions { align-items: stretch; flex-direction: column; }
}

@media (max-width: 760px) {
  .app-shell {
    display: block !important;
  }

  .app-sidebar {
    position: fixed !important;
    inset: auto 0 0 0 !important;
    width: 100% !important;
    height: 72px !important;
    min-height: 0 !important;
    z-index: 60 !important;
    border-right: 0 !important;
    border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
    padding: 5px 8px max(5px, env(safe-area-inset-bottom)) !important;
    backdrop-filter: blur(18px);
    background: rgba(6, 6, 8, 0.95) !important;
  }

  .app-sidebar > div:first-child,
  .app-sidebar-footer {
    display: none !important;
  }

  .app-sidebar-nav {
    padding: 0 !important;
    flex-direction: row !important;
    justify-content: space-around;
    align-items: center;
    gap: 4px !important;
    overflow: visible !important;
  }

  .sidebar-nav-button {
    min-width: 0 !important;
    flex: 1 1 0;
    height: 56px;
    padding: 5px 3px !important;
    flex-direction: column;
    justify-content: center;
    gap: 3px !important;
    text-align: center !important;
    font-size: 0.67rem !important;
    border-radius: 13px !important;
    letter-spacing: 0 !important;
  }

  .app-workspace {
    min-height: 100vh;
    overflow: visible !important;
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
  }

  .app-main {
    margin: 18px auto !important;
    padding: 0 16px 24px !important;
  }

  .app-workspace > footer {
    margin-bottom: 0;
  }

  .learning-topbar { margin: -2px 0 26px; }
  .learning-search { width: calc(100% - 52px); }
  .learning-search kbd { display: none; }
  .learning-heading { align-items: flex-start; margin-bottom: 18px; }
  .learning-heading blockquote { display: none; }
  .learning-layout { grid-template-columns: minmax(0, 1fr); }
  .learning-side-column { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .continue-copy { width: 100%; padding: 21px 18px; }
  .continue-card { min-height: 290px; }
  .continue-art { width: 64%; top: auto; height: 145px; opacity: .52; }
  .continue-current { max-width: 90%; }
  .continue-current p { max-width: 230px; }
  .continue-actions { position: relative; z-index: 2; margin-top: 18px; }
  .twin-evidence-grid, .recommendation-grid { grid-template-columns: 1fr; }
  .evidence-card { min-height: 88px; }
  .learning-promo-card { min-height: 100%; }
}

@media (max-width: 440px) {
  .learning-side-column { display: flex; }
  .focus-content { justify-content: flex-start; gap: 24px; }
  .learning-heading h1 { font-size: 34px; }
  .learning-heading p { font-size: 13px; }
  .continue-actions { gap: 8px; }
  .learning-primary, .learning-secondary { padding: 0 12px; font-size: 12px; }
}

.purple-glow-btn {
  box-shadow: 0 0 25px -4px rgba(104, 0, 203, 0.65);
}

.purple-glow-btn:hover {
  box-shadow: 0 0 32px 0px rgba(139, 44, 245, 0.85);
}

.glow-purple-box {
  box-shadow: 0 4px 20px -2px rgba(104, 0, 203, 0.45);
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #050505;
}
::-webkit-scrollbar-thumb {
  background: #201e2c;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #37334a;
}

/* Badges */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.02em;
}

.badge-blue, .badge-purple {
  background: #241135;
  color: #d7baff;
  border: 1px solid #51366a;
}

/* Shared dashboard spacing, restrained glass surfaces, and entrance motion. */
.progress-dashboard,
.teacher-dashboard,
.team-dashboard,
.learn-dashboard,
.assessment-dashboard {
  --dashboard-glass: rgba(20, 19, 29, .72);
  --dashboard-glass-border: rgba(205, 186, 235, .13);
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.progress-dashboard > *,
.teacher-dashboard > *,
.team-dashboard > *,
.learn-dashboard > *,
.assessment-dashboard > * {
  animation: dashboard-arrive .55s cubic-bezier(.2,.7,.25,1) both;
}
.progress-dashboard > :nth-child(2), .teacher-dashboard > :nth-child(2), .team-dashboard > :nth-child(2), .learn-dashboard > :nth-child(2), .assessment-dashboard > :nth-child(2) { animation-delay: .07s; }
.progress-dashboard > :nth-child(3), .teacher-dashboard > :nth-child(3), .team-dashboard > :nth-child(3), .learn-dashboard > :nth-child(3), .assessment-dashboard > :nth-child(3) { animation-delay: .14s; }
.progress-dashboard > :nth-child(4), .teacher-dashboard > :nth-child(4), .team-dashboard > :nth-child(4), .learn-dashboard > :nth-child(4), .assessment-dashboard > :nth-child(4) { animation-delay: .21s; }
@keyframes dashboard-arrive { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

.progress-metric,
.progress-panel,
.team-detail-card,
.team-list-item,
.team-session-item,
.progress-dashboard .card-panel,
.teacher-dashboard .card-panel,
.team-dashboard .card-panel,
.learn-dashboard .card-panel,
.assessment-dashboard .card-panel,
.teacher-dashboard .bg-surface-container-low.rounded-xl {
  background: var(--dashboard-glass, rgba(20, 19, 29, .72));
  border-color: var(--dashboard-glass-border, rgba(205, 186, 235, .13));
  box-shadow: 0 12px 32px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.035);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}
.progress-metrics { gap: 17px; }
.progress-overview-grid { gap: 19px; }
.progress-panel { padding: 24px; }
.progress-panel + .progress-panel { margin-top: 2px; }
.team-overview-grid, .team-detail-grid { gap: 20px; }
.team-detail-card { padding: 24px; }

@media (prefers-reduced-motion: reduce) {
  .progress-dashboard > *, .teacher-dashboard > *, .team-dashboard > *, .learn-dashboard > *, .assessment-dashboard > * { animation: none !important; }
}

.badge-emerald {
  background: rgba(78, 222, 163, 0.15);
  color: #4edea3;
  border: 1px solid rgba(78, 222, 163, 0.3);
}

.badge-amber {
  background: rgba(245, 158, 11, 0.15);
  color: #fbbf24;
  border: 1px solid rgba(251, 191, 36, 0.3);
}

.badge-rose, .badge-error {
  background: rgba(255, 180, 171, 0.15);
  color: #ffb4ab;
  border: 1px solid rgba(255, 180, 171, 0.3);
}

.badge-neutral {
  background: #18181c;
  color: #cdc2d7;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: var(--radius-md);
  font-weight: 600;
  font-size: 0.875rem;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  font-family: inherit;
  text-decoration: none;
}

.btn-primary {
  background: #6800cb;
  color: #FFFFFF;
  border: 1px solid rgba(215, 186, 255, 0.35);
  box-shadow: 0 0 20px -2px rgba(104, 0, 203, 0.5);
}

.btn-primary:hover {
  background: #780edd;
  box-shadow: 0 0 28px 0px rgba(139, 44, 245, 0.75);
  transform: translateY(-1px);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  background: #18181c;
  color: #e5e2e1;
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.btn-secondary:hover {
  background: #222228;
  border-color: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
}

.btn-outline-purple {
  background: transparent;
  color: #d7baff;
  border: 1px solid rgba(215, 186, 255, 0.3);
}

.btn-outline-purple:hover {
  background: rgba(104, 0, 203, 0.2);
  border-color: #d7baff;
}

/* Form Inputs */
input[type="text"],
input[type="email"],
input[type="password"],
select,
textarea {
  background-color: #121216 !important;
  color: #FFFFFF !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  border-radius: var(--radius-md);
  padding: 10px 14px;
  font-family: inherit;
  font-size: 0.9rem;
  transition: all 0.15s ease;
  outline: none;
}

input[type="text"]:focus,
input[type="email"]:focus,
input[type="password"]:focus,
select:focus,
textarea:focus {
  border-color: #a855f7 !important;
  box-shadow: 0 0 0 3px rgba(104, 0, 203, 0.3) !important;
}

select option {
  background-color: #121216;
  color: #FFFFFF;
}

/* Progress bar utility */
.progress-container {
  width: 100%;
  height: 8px;
  background-color: #1a1a24;
  border-radius: 999px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #6800cb, #a855f7);
  box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
  transition: width 0.4s ease;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

.fade-in {
  animation: fadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* Landing Page Hero Buttons and Ambient Lighting Effects */
.nav-link-transition {
  transition: color 0.2s ease-in-out;
}
.nav-link-transition:hover {
  color: #FFFFFF;
}

.btn-violet {
  background-color: #6800CB;
  transition: all 0.2s ease;
  box-shadow: 0 4px 18px rgba(104, 0, 203, 0.35);
}
.btn-violet:hover {
  background-color: #780edd;
  box-shadow: 0 6px 24px rgba(104, 0, 203, 0.55);
  transform: translateY(-1px);
}

.btn-outline {
  border: 1px solid rgba(255, 255, 255, 0.22);
  transition: all 0.2s ease;
}
.btn-outline:hover {
  background-color: rgba(255, 255, 255, 0.06);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-1px);
}

@keyframes heroFloat {
  0%, 100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-9px);
  }
}

@keyframes warmLampGlow {
  0%, 100% {
    opacity: 0.45;
    transform: scale(0.98);
    filter: blur(50px);
  }
  50% {
    opacity: 0.75;
    transform: scale(1.08);
    filter: blur(65px);
  }
}

@keyframes purpleAmbientGlow {
  0%, 100% {
    opacity: 0.35;
    transform: scale(1);
    filter: blur(60px);
  }
  50% {
    opacity: 0.58;
    transform: scale(1.08);
    filter: blur(72px);
  }
}

@keyframes lampBreathingPulse {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.95;
    transform: scale(1.08);
  }
}

@keyframes writingMotion {
  0% {
    transform: translate(0px, 0px);
    opacity: 0.7;
  }
  25% {
    transform: translate(7px, 3px);
    opacity: 1;
  }
  50% {
    transform: translate(3px, 6px);
    opacity: 0.85;
  }
  75% {
    transform: translate(11px, 2px);
    opacity: 1;
  }
  100% {
    transform: translate(0px, 0px);
    opacity: 0.7;
  }
}

@keyframes pencilGlowFlicker {
  0%, 100% {
    filter: drop-shadow(0 0 4px rgba(254, 240, 138, 0.8)) drop-shadow(0 0 10px rgba(234, 179, 8, 0.6));
    opacity: 0.8;
  }
  30% {
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.95)) drop-shadow(0 0 16px rgba(234, 179, 8, 0.9));
    opacity: 1;
  }
  70% {
    filter: drop-shadow(0 0 5px rgba(254, 240, 138, 0.85)) drop-shadow(0 0 12px rgba(234, 179, 8, 0.7));
    opacity: 0.85;
  }
}

@keyframes deskDustFloat1 {
  0% { transform: translate(0, 0) scale(0.6); opacity: 0; }
  20% { opacity: 0.8; }
  80% { opacity: 0.6; }
  100% { transform: translate(-8px, -24px) scale(1); opacity: 0; }
}

@keyframes deskDustFloat2 {
  0% { transform: translate(0, 0) scale(0.5); opacity: 0; }
  30% { opacity: 0.9; }
  70% { opacity: 0.5; }
  100% { transform: translate(10px, -28px) scale(0.9); opacity: 0; }
}

@keyframes deskDustFloat3 {
  0% { transform: translate(0, 0) scale(0.4); opacity: 0; }
  25% { opacity: 0.85; }
  75% { opacity: 0.5; }
  100% { transform: translate(-3px, -20px) scale(0.85); opacity: 0; }
}

.hero-float-container {
  animation: heroFloat 6.5s ease-in-out infinite;
  will-change: transform;
}

.hero-glow-warm {
  animation: warmLampGlow 5.5s ease-in-out infinite;
  background: radial-gradient(circle at 35% 42%, rgba(234, 179, 8, 0.48) 0%, rgba(245, 158, 11, 0.22) 40%, transparent 72%);
}

.hero-glow-purple {
  animation: purpleAmbientGlow 7s ease-in-out infinite 0.6s;
  background: radial-gradient(circle at 65% 58%, rgba(104, 0, 203, 0.45) 0%, rgba(120, 14, 221, 0.2) 45%, transparent 75%);
}

.seamless-hero-img-wrap {
  mask-image: radial-gradient(ellipse 72% 68% at 46% 54%, rgba(0, 0, 0, 1) 32%, rgba(0, 0, 0, 0.85) 54%, rgba(0, 0, 0, 0.25) 75%, transparent 95%);
  -webkit-mask-image: radial-gradient(ellipse 72% 68% at 46% 54%, rgba(0, 0, 0, 1) 32%, rgba(0, 0, 0, 0.85) 54%, rgba(0, 0, 0, 0.25) 75%, transparent 95%);
}

.lamp-breathing-beam {
  animation: lampBreathingPulse 2s ease-in-out infinite;
  background: radial-gradient(ellipse 48% 46% at 38% 48%, rgba(254, 240, 138, 0.35) 0%, rgba(234, 179, 8, 0.2) 40%, rgba(245, 158, 11, 0.05) 70%, transparent 100%);
  mix-blend-mode: screen;
}

.pencil-shimmer-motion {
  animation: writingMotion 2s ease-in-out infinite, pencilGlowFlicker 2s ease-in-out infinite;
}

.dust-particle-1 {
  animation: deskDustFloat1 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

.dust-particle-2 {
  animation: deskDustFloat2 2s cubic-bezier(0.4, 0, 0.2, 1) infinite 0.65s;
}

.dust-particle-3 {
  animation: deskDustFloat3 2s cubic-bezier(0.4, 0, 0.2, 1) infinite 1.25s;
}

.hero-illustration-card {
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
}

.hero-float-container:hover .hero-illustration-card {
  filter: brightness(1.06) contrast(1.04) drop-shadow(0 0 24px rgba(234, 179, 8, 0.28));
}

/* Shared wordmark, typography, and landing video presentation. */
.landing-frame, .landing-frame * { font-family: var(--font-sans); }
.landing-video { display: block; filter: grayscale(1) brightness(.86); object-position: center; }
.knowledge-twin-logo { position: relative; width: min(100%, 205px); min-width: 0; overflow: hidden; transition: filter 220ms ease, transform 220ms ease; }
.knowledge-twin-logo > div { display: none !important; }
.knowledge-twin-logo .shared-wordmark { display: block; width: min(100%, 205px); height: 54px; object-fit: cover; object-position: center; mix-blend-mode: screen; }
.knowledge-twin-logo:hover { filter: drop-shadow(0 0 9px rgba(157, 78, 221, .36)); }
.learning-heading blockquote, .learning-quote-card p { font-family: var(--font-sans); }

/* Learn dashboard: focused topic browser, with lively but restrained interactions. */
.learn-dashboard { --learn-purple: #8b18f5; --learn-lavender: #c785ff; color: #eceaf3; width: 100%; max-width: 1200px; margin: 0 auto; }
.learn-topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: -5px 0 38px; }
.learn-global-search, .learn-topic-search { display: flex; align-items: center; gap: 16px; height: 48px; border: 1px solid #292a35; border-radius: 999px; background: linear-gradient(100deg, #0d0e14, #0b0c11); color: #b9bfd0; transition: border-color .2s, box-shadow .2s, background .2s; }
.learn-global-search { width: min(630px, 78%); padding: 0 19px; }
.learn-global-search:focus-within, .learn-topic-search:focus-within { border-color: rgba(161, 63, 255, .7); box-shadow: 0 0 0 3px rgba(132, 21, 235, .13), 0 0 26px rgba(132, 21, 235, .12); }
.learn-global-search input, .learn-topic-search input { width: 100%; min-width: 0; padding: 0 !important; border: 0 !important; outline: 0 !important; background: transparent !important; color: #f4f2fa !important; box-shadow: none !important; font: 500 14px var(--font-sans) !important; }
.learn-global-search input::placeholder, .learn-topic-search input::placeholder { color: #a5a8b8; }
.learn-notification { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: transparent; color: #c588ff; cursor: pointer; transition: background .2s, transform .2s; }
.learn-notification > svg { filter: drop-shadow(0 0 5px rgba(172, 75, 255, .25)); }
.learn-notification span { position: absolute; width: 8px; height: 8px; top: 7px; right: 8px; border-radius: 50%; background: #9229ff; box-shadow: 0 0 12px #9229ff; }
.learn-notification:hover { background: rgba(147, 51, 234, .12); transform: translateY(-2px); }
.learn-heading { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: 27px; }
.learn-eyebrow { color: #b7bfd2; font-size: 12px; letter-spacing: .16em; font-weight: 600; }
.learn-heading h1 { margin: 7px 0 0; color: #f8f7fb; font-size: clamp(36px, 4vw, 54px); font-weight: 800; letter-spacing: -.045em; line-height: 1.08; }
.learn-heading p { margin-top: 4px; color: #b8bfd0; font-size: clamp(14px, 1.35vw, 18px); }
.learn-heading blockquote { margin: 0 10px 0 0; color: #c6c9d6; font: italic 20px/1.45 Georgia, serif; text-align: right; }
.learn-tabs { display: flex; align-items: stretch; gap: clamp(14px, 3.1vw, 43px); min-height: 57px; border-bottom: 1px solid #2b2b35; overflow-x: auto; }
.learn-tab { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 12px; flex: 0 0 auto; min-width: 132px; padding: 10px 14px 15px; border: 0; background: transparent; color: #b8bfd0; font: 500 16px var(--font-sans); cursor: pointer; transition: color .2s, text-shadow .2s; }
.learn-tab::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 4px; border-radius: 4px 4px 0 0; background: linear-gradient(90deg, #7820eb, #bf44ff); content: ''; transform: scaleX(0); transform-origin: left; transition: transform .25s ease; }
.learn-tab:hover { color: #f1e6ff; text-shadow: 0 0 16px rgba(179, 104, 255, .55); }
.learn-tab.is-active { color: #fff; }
.learn-tab.is-active > svg { color: #ca86ff; filter: drop-shadow(0 0 7px rgba(183, 95, 255, .7)); }
.learn-tab.is-active::after { transform: scaleX(1); }
.learn-tab-count { display: grid; min-width: 19px; height: 19px; place-items: center; border-radius: 99px; background: rgba(140, 35, 238, .22); color: #d6a7ff; font-size: 11px; }
.learn-browser { padding-top: 22px; }
.learn-topic-search { height: 52px; padding: 0 22px; border-radius: 17px; }
.learn-topic-search input { font-size: 16px !important; }
.learn-filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 20px 0 23px; }
.learn-filter { min-width: 89px; padding: 10px 20px; border: 1px solid #30313d; border-radius: 11px; background: linear-gradient(140deg, #0b0c11, #090a0f); color: #c4c8d4; font: 500 14px var(--font-sans); cursor: pointer; transition: color .2s, border-color .2s, background .2s, box-shadow .2s, transform .2s; }
.learn-filter:hover { transform: translateY(-2px); border-color: rgba(184, 91, 255, .7); color: white; box-shadow: 0 7px 19px rgba(108, 19, 183, .16); }
.learn-filter.is-active { border-color: #8720e9; background: linear-gradient(110deg, #7415dc, #4e0ac1); color: #fff; box-shadow: 0 6px 20px rgba(104, 0, 203, .28), inset 0 1px rgba(255,255,255,.14); }
.learn-upload-link { display: inline-flex; align-items: center; gap: 8px; margin-left: auto; padding: 9px 12px; border: 1px solid transparent; border-radius: 10px; background: transparent; color: #c889ff; font: 600 13px var(--font-sans); cursor: pointer; transition: background .2s, border-color .2s, transform .2s; }
.learn-upload-link:hover { transform: translateY(-2px); border-color: rgba(172, 93, 255, .35); background: rgba(113, 28, 190, .12); }
.learn-topic-list { display: flex; flex-direction: column; gap: 9px; }
.learn-topic-row { position: relative; display: flex; align-items: center; gap: 30px; min-height: 91px; padding: 13px 22px; border: 1px solid #252631; border-radius: 13px; background: linear-gradient(110deg, rgba(14, 15, 21, .96), rgba(9, 10, 15, .98)); transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease, background .22s ease; }
.learn-topic-row:hover { z-index: 1; transform: translateY(-3px) scale(1.003); border-color: rgba(156, 67, 239, .63); background: linear-gradient(110deg, #11111a, #0c0c14); box-shadow: 0 13px 32px rgba(0,0,0,.32), 0 0 25px rgba(108, 24, 181, .12); }
.learn-topic-icon { display: grid; flex: 0 0 58px; width: 58px; height: 58px; place-items: center; border: 1px solid rgba(174, 73, 245, .15); border-radius: 12px; background: linear-gradient(145deg, rgba(91, 23, 139, .29), rgba(43, 13, 75, .34)); color: #c279ff; transition: transform .22s ease, box-shadow .22s ease, color .22s ease; }
.learn-topic-row:hover .learn-topic-icon { transform: scale(1.05) rotate(-2deg); color: #dfaaff; box-shadow: 0 0 22px rgba(146, 42, 226, .21); }
.learn-topic-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 5px; }
.learn-topic-copy strong { overflow: hidden; color: #f4f2f8; font-size: 16px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.learn-topic-copy > span { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; color: #adb2c1; font-size: 13px; }
.learn-topic-copy > span i { width: 4px; height: 4px; border-radius: 50%; background: #a6aabe; }
.learn-status { margin-left: 5px; padding: 2px 8px; border: 1px solid rgba(255,255,255,.07); border-radius: 99px; color: #999eae; font-size: 10px; font-style: normal; }
.learn-status.status-in-progress { border-color: rgba(187, 111, 255, .25); background: rgba(132, 26, 215, .12); color: #d1a0ff; }
.learn-status.status-completed { border-color: rgba(68, 210, 155, .2); color: #73dcb2; }
.learn-topic-actions { display: flex; align-items: center; gap: 8px; }
.learn-start { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-width: 115px; min-height: 44px; padding: 0 19px; border: 1px solid #9a27ff; border-radius: 10px; background: rgba(102, 18, 166, .12); color: #d18bff; font: 600 14px var(--font-sans); cursor: pointer; transition: transform .2s, background .2s, color .2s, box-shadow .2s; }
.learn-start:hover { transform: translateY(-2px); background: linear-gradient(110deg, #7415dc, #560cc8); color: #fff; box-shadow: 0 8px 22px rgba(122, 22, 217, .3); }
.learn-start.is-progress { background: linear-gradient(110deg, #7415dc, #560cc8); color: #fff; }
.learn-start.is-complete { border-color: rgba(70, 207, 152, .4); color: #81ddb5; }
.learn-start.is-complete:hover { background: rgba(28, 118, 82, .23); }
.learn-bookmark, .learn-mark-done { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; border: 1px solid transparent; border-radius: 10px; background: transparent; color: #85899b; cursor: pointer; transition: all .2s; }
.learn-bookmark:hover, .learn-bookmark.is-saved { border-color: rgba(178, 100, 255, .28); background: rgba(124, 29, 193, .15); color: #cf8fff; }
.learn-mark-done { width: 29px; height: 29px; border-color: #343541; }
.learn-mark-done:hover { border-color: rgba(74, 211, 157, .55); background: rgba(35, 128, 90, .14); color: #75ddb3; }
.learn-empty { display: flex; min-height: 210px; flex-direction: column; align-items: center; justify-content: center; gap: 9px; padding: 26px; border: 1px dashed #30303d; border-radius: 14px; color: #9fa3b3; text-align: center; }
.learn-empty > svg { color: #b75aff; }
.learn-empty strong { color: #efedf5; font-size: 17px; }
.learn-empty span { max-width: 400px; font-size: 13px; }
.learn-empty button { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; padding: 9px 14px; border: 1px solid #8123db; border-radius: 9px; background: #4b0c92; color: white; cursor: pointer; }
@media (max-width: 720px) {
  .learn-topbar { margin-bottom: 26px; }
  .learn-heading { align-items: flex-start; }
  .learn-heading blockquote { display: none; }
  .learn-tab { min-width: auto; gap: 8px; padding-right: 10px; padding-left: 10px; font-size: 13px; }
  .learn-tab > svg { width: 19px; height: 19px; }
  .learn-filter-row { gap: 8px; }
  .learn-filter { min-width: 0; padding: 9px 12px; font-size: 12px; }
  .learn-upload-link { margin-left: 0; }
  .learn-topic-row { gap: 13px; padding: 12px; }
  .learn-topic-icon { flex-basis: 46px; width: 46px; height: 46px; }
  .learn-topic-icon svg { width: 22px; height: 22px; }
  .learn-topic-copy strong { font-size: 14px; }
  .learn-topic-copy > span { font-size: 11px; }
  .learn-status { display: none; }
  .learn-topic-actions { gap: 3px; }
  .learn-start { min-width: auto; min-height: 38px; gap: 5px; padding: 0 10px; font-size: 12px; }
  .learn-bookmark { width: 30px; height: 30px; }
  .learn-mark-done { display: none; }
}
@media (prefers-reduced-motion: reduce) { .learn-dashboard *, .learn-dashboard *::before, .learn-dashboard *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }

/* Shared dashboard language for team, teacher overview, and learner progress. */
.team-topbar, .teacher-topbar, .progress-topbar { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: -6px 0 16px; }
.team-topbar label, .teacher-topbar label, .progress-topbar label { display: flex; width: min(580px, 78%); height: 42px; align-items: center; gap: 12px; padding: 0 16px; border: 1px solid #292a35; border-radius: 999px; background: #0c0d13; color: #b9bfd0; transition: border-color .2s, box-shadow .2s; }
.team-topbar label:focus-within, .teacher-topbar label:focus-within, .progress-topbar label:focus-within { border-color: #8622db; box-shadow: 0 0 0 3px rgba(132, 21, 235, .14); }
.team-topbar input, .teacher-topbar input, .progress-topbar input { flex: 1; width: 100%; min-width: 0; border: 0 !important; outline: 0 !important; background: transparent !important; color: #f1eff7 !important; font: 13px var(--font-sans) !important; box-shadow: none !important; }
.team-topbar input::placeholder, .teacher-topbar input::placeholder, .progress-topbar input::placeholder { color: #a5a8b8; }
.team-topbar > button, .teacher-topbar > button, .progress-topbar > button { position: relative; display: grid; width: 40px; height: 40px; place-items: center; border: 0; border-radius: 50%; background: transparent; color: #c084fc; cursor: pointer; transition: background .2s, transform .2s; }
.team-topbar > button:hover, .teacher-topbar > button:hover, .progress-topbar > button:hover { transform: translateY(-2px); background: rgba(143, 47, 226, .14); }
.team-topbar > button span, .teacher-topbar > button i, .progress-topbar > button span { position: absolute; top: 7px; right: 7px; width: 8px; height: 8px; border-radius: 50%; background: #9229ff; box-shadow: 0 0 10px #9229ff; }
.team-heading h1 { color: #faf9fc !important; font-size: clamp(38px, 4vw, 54px) !important; line-height: 1.06; }
.team-heading h1 span { color: #8d20f2; }
.team-heading h1::first-letter { color: #fff; }
.team-heading p { font-size: 16px !important; }
.team-heading > div:last-child { align-self: center; }
.team-tabs, .progress-tabs { display: flex; align-items: stretch; gap: clamp(12px, 2.8vw, 38px); min-height: 48px; border-bottom: 1px solid #2b2b35; overflow-x: auto; }
.team-tabs button, .progress-tabs button { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 9px; flex: 0 0 auto; min-width: 115px; padding: 8px 15px 12px; border: 0; background: transparent; color: #b8bfd0; font: 500 14px var(--font-sans); cursor: pointer; transition: color .2s, text-shadow .2s; }
.team-tabs button::after, .progress-tabs button::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 4px; border-radius: 4px 4px 0 0; background: linear-gradient(90deg, #7820eb, #bf44ff); content: ''; transform: scaleX(0); transition: transform .22s ease; }
.team-tabs button:hover, .progress-tabs button:hover { color: #f6edff; text-shadow: 0 0 14px rgba(179, 104, 255, .45); }
.team-tabs button.is-active, .progress-tabs button.is-active { color: #fff; }
.team-tabs button.is-active::after, .progress-tabs button.is-active::after { transform: scaleX(1); }
.team-overview-grid { grid-template-columns: minmax(0, 1.45fr) minmax(300px, .9fr) !important; gap: 18px !important; }
.team-overview-grid .card-panel { transition: transform .22s, border-color .22s, box-shadow .22s; }
.team-overview-grid .card-panel:hover { transform: translateY(-2px); border-color: rgba(156, 67, 239, .55) !important; box-shadow: 0 12px 30px rgba(0,0,0,.28), 0 0 20px rgba(108,24,181,.1); }
.team-detail-grid { display: grid; grid-template-columns: minmax(270px, .8fr) minmax(0, 1.4fr); gap: 18px; }
.team-detail-card { min-width: 0; padding: 22px; border: 1px solid #242530; border-radius: 14px; background: linear-gradient(140deg, #0e0f15, #090a0f); color: #d9dbe4; }
.team-detail-card > h2 { margin: 4px 0 5px; color: #f5f3f8; font-size: 20px; }
.team-detail-card > p { margin-bottom: 17px; color: #aeb3c2; font-size: 13px; }
.team-goal-feature { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: 10px; min-height: 230px; background: radial-gradient(ellipse at 10% 5%, rgba(111,22,193,.22), transparent 65%), #0d0d14; }
.team-goal-feature > svg { color: #c27bff; }
.team-card-eyebrow { color: #b9bfd0; font-size: 10px; font-weight: 700; letter-spacing: .15em; }
.team-goal-feature h2 { max-width: 380px; margin: 0; color: #f6f4f9; font-size: 22px; }
.team-goal-feature p { color: #aeb3c2; font-size: 13px; }
.team-goal-feature > strong { color: #d7adff; font-size: 12px; }
.team-progress-track { width: 100%; height: 7px; overflow: hidden; border-radius: 99px; background: #1d1d28; }
.team-progress-track i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #7918da, #b542ff); box-shadow: 0 0 12px rgba(153,43,242,.4); }
.team-list-item { display: flex; flex-direction: column; gap: 7px; margin-top: 10px; padding: 14px; border: 1px solid #252631; border-radius: 11px; background: #0a0b10; }
.team-list-item > span { color: #c180ff; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.team-list-item > strong { color: #f1eef6; font-size: 14px; line-height: 1.5; }
.team-list-item > small { color: #a8adbb; font-size: 11px; }
.team-list-item > button, .team-session-item > button { display: inline-flex; align-items: center; gap: 7px; align-self: flex-start; margin-top: 4px; padding: 7px 11px; border: 1px solid #7721c6; border-radius: 8px; background: rgba(109,22,176,.16); color: #d4a2ff; cursor: pointer; transition: .2s; }
.team-list-item > button:hover, .team-session-item > button:hover { background: #6913b9; color: white; box-shadow: 0 5px 16px rgba(105,19,185,.25); }
.team-session-item { display: flex; align-items: center; gap: 14px; margin-top: 10px; padding: 13px; border: 1px solid #252631; border-radius: 11px; background: #0a0b10; transition: border-color .2s, transform .2s; }
.team-session-item:hover { transform: translateY(-2px); border-color: rgba(156,67,239,.55); }
.team-detail-icon { display: grid; width: 42px; height: 42px; flex: 0 0 42px; place-items: center; border-radius: 10px; background: rgba(113,27,177,.18); color: #c27bff; }
.team-session-item > div { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3px; }
.team-session-item > div strong { color: #f1eef6; font-size: 13px; }
.team-session-item > div small { color: #a8adbb; font-size: 11px; }
.team-session-count { color: #bdb5cc; font-size: 11px; }
.team-empty { padding: 30px; border: 1px dashed #30303d; border-radius: 12px; color: #a8adbb; text-align: center; }
.teacher-header { display: block !important; padding: 2px 0 0 !important; border: 0 !important; background: transparent !important; box-shadow: none !important; }
.teacher-header > div:first-child > div:first-child { margin: 0 !important; }
.teacher-header > div:first-child > div:first-child > span:first-child { font-size: 11px; letter-spacing: .16em; }
.teacher-header > div:first-child > div:first-child > span:last-child { display: none; }
.teacher-header h1 { margin-top: 5px; font-size: clamp(34px, 3.3vw, 47px) !important; }
.teacher-header h1 span { color: #8d20f2; }
.teacher-header p { margin-top: 4px !important; color: #afb5c5 !important; font-size: 15px !important; }
.teacher-header .teacher-tabs { display: flex; width: 100%; justify-content: flex-start; gap: 18px; margin-top: 20px; padding: 0 0 0 !important; border: 0 !important; border-bottom: 1px solid #2b2b35 !important; border-radius: 0 !important; background: transparent !important; }
.teacher-header .teacher-tabs button { position: relative; padding: 10px 15px 13px; border-radius: 0 !important; background: transparent !important; color: #b8bfd0 !important; font-size: 13px; }
.teacher-header .teacher-tabs button:hover { color: #fff !important; }
.teacher-header .teacher-tabs button[class*="bg-primary"] { color: #fff !important; box-shadow: none !important; }
.teacher-header .teacher-tabs button[class*="bg-primary"]::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 4px; border-radius: 4px 4px 0 0; background: linear-gradient(90deg,#7820eb,#bf44ff); content: ''; }
.teacher-dashboard > div:nth-of-type(3) > .grid > .card-panel { transition: transform .2s, border-color .2s, box-shadow .2s; }
.teacher-dashboard > div:nth-of-type(3) > .grid > .card-panel:hover { transform: translateY(-3px); border-color: rgba(149,59,232,.45); box-shadow: 0 12px 26px rgba(0,0,0,.25), 0 0 20px rgba(108,24,181,.12); }
.teacher-load-error { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:12px 16px; border:1px solid rgba(184,141,72,.38); border-radius:12px; background:rgba(103,72,25,.14); color:#d5c8ac; font-size:13px; }
.teacher-load-error button { flex:0 0 auto; padding:7px 13px; border:1px solid rgba(203,177,126,.42); border-radius:8px; background:rgba(255,255,255,.04); color:#f0e7d4; cursor:pointer; }
.teacher-load-error button:hover { background:rgba(255,255,255,.09); }

/* Teacher pages use open sections and dividers instead of nested card tiles. */
.teacher-dashboard .card-panel {
  background: transparent !important;
  border-color: transparent !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  transition: none !important;
}
.teacher-dashboard .card-panel:hover { border-color: transparent !important; box-shadow: none !important; transform: none !important; }
.teacher-dashboard .grid > .card-panel { border-bottom: 1px solid rgba(255,255,255,.1) !important; }
.teacher-dashboard .flex.flex-col.gap-6 > .card-panel { border-bottom: 1px solid rgba(255,255,255,.1) !important; padding-bottom: 24px !important; }
.teacher-dashboard .bg-surface-container-low.rounded-xl {
  border-color: transparent transparent rgba(255,255,255,.1) !important;
  border-radius: 0 !important;
  background: transparent !important;
}
.teacher-dashboard .bg-surface-container-low.rounded-xl:hover { background: rgba(255,255,255,.025) !important; border-color: transparent transparent rgba(255,255,255,.2) !important; }
.teacher-dashboard .teacher-topbar label { background: #0b0c11; }
.teacher-dashboard .teacher-tabs { gap:20px!important; padding:0!important; border:0!important; border-bottom:1px solid #292932!important; border-radius:0!important; background:transparent!important; }
.teacher-dashboard .teacher-tabs button { padding:12px 8px!important; border:0!important; border-radius:0!important; background:transparent!important; box-shadow:none!important; color:#afb5c6!important; }
.teacher-dashboard .teacher-tabs button.bg-primary { border-bottom:2px solid #a932f2!important; color:#f4efff!important; }
.teacher-dashboard div.rounded-xl.border { border-color:transparent transparent rgba(255,255,255,.12)!important; border-radius:0!important; background:transparent!important; }
.teacher-dashboard .bg-surface-container,.teacher-dashboard .bg-surface-container-low { background:transparent!important; }
.teacher-dashboard .card-panel .w-10.h-10.rounded-xl { border:0!important; background:transparent!important; }

/* Premium glass treatment for the active sidebar destination. */
.sidebar-nav-button.is-active {
  position:relative;
  isolation:isolate;
  overflow:hidden;
  width:calc(100% + 6px)!important;
  min-height:54px;
  margin-left:-3px;
  padding:13px 18px!important;
  font-size:.97rem!important;
  border:1px solid rgba(211,177,255,.34)!important;
  border-radius:0!important;
  clip-path:polygon(0 10px,10px 0,calc(100% - 15px) 0,100% 15px,100% calc(100% - 10px),calc(100% - 10px) 100%,15px 100%,0 calc(100% - 15px));
  background:linear-gradient(112deg,rgba(104,0,203,.7),rgba(78,20,130,.76) 55%,rgba(47,24,75,.84))!important;
  -webkit-backdrop-filter:blur(18px) saturate(145%);
  backdrop-filter:blur(18px) saturate(145%);
  box-shadow:inset 0 1px rgba(255,255,255,.18),inset 0 0 0 1px rgba(208,173,246,.1),0 6px 22px rgba(104,0,203,.23)!important;
}
.sidebar-nav-button.is-active::before {
  position:absolute;
  z-index:0;
  inset:1px;
  background:linear-gradient(140deg,rgba(255,255,255,.09),transparent 35%,transparent 72%,rgba(187,126,243,.06));
  content:'';
  pointer-events:none;
}
.sidebar-nav-button.is-active::after {
  position:absolute;
  z-index:0;
  top:20%;
  bottom:20%;
  left:0;
  width:2px;
  background:linear-gradient(180deg,transparent,#ddaaff 24%,#b45cff 76%,transparent);
  content:'';
  box-shadow:0 0 9px rgba(188,113,255,.65);
  pointer-events:none;
}
.sidebar-nav-button.is-active > * { position:relative; z-index:1; }
.sidebar-nav-button.is-active:hover { filter:brightness(1.09) drop-shadow(0 6px 14px rgba(117,53,165,.22))!important; }
.sidebar-nav-button.is-active:focus-visible { outline:2px solid rgba(218,185,255,.8); outline-offset:3px; }

/* Student Knowledge Twin, using the supplied teaching-profile composition adapted to learner evidence. */
.student-twin-page { width:100%; color:#f4f3f7; }
.student-twin-topbar { display:flex; align-items:center; justify-content:space-between; gap:18px; margin:-4px 0 27px; }
.student-twin-topbar label { display:flex; align-items:center; gap:13px; width:min(650px,78%); height:46px; padding:0 16px; border:1px solid #292a35; border-radius:999px; background:#0c0d13; color:#bdc2d2; }
.student-twin-topbar label:focus-within { border-color:#8b3bd2; box-shadow:0 0 0 3px rgba(139,59,210,.12); }
.student-twin-topbar input { width:100%; min-width:0; border:0!important; outline:0!important; background:transparent!important; color:#f4f2f7!important; box-shadow:none!important; font:14px var(--font-sans)!important; }
.student-twin-topbar input::placeholder { color:#9ea3b4; }
.student-twin-topbar > button { position:relative; display:grid; width:40px; height:40px; place-items:center; border:0; border-radius:50%; background:transparent; color:#c178f2; }
.student-twin-topbar > button i { position:absolute; top:5px; right:6px; width:8px; height:8px; border-radius:50%; background:#9229ff; box-shadow:0 0 10px #9229ff; }
.student-twin-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:24px; margin-bottom:22px; }
.student-twin-heading > div > span { color:#b8bfd2; font-size:12px; font-weight:650; letter-spacing:.17em; }
.student-twin-heading h1 { margin:3px 0 1px; color:#f8f7fa; font-size:clamp(38px,4vw,54px); font-weight:800; letter-spacing:-.045em; line-height:1.1; }
.student-twin-heading h1 b { color:#8e2ce1; }
.student-twin-heading p { margin:5px 0 0; color:#b8c2d7; font-size:17px; }
.student-twin-heading blockquote { margin:20px 0 0; color:#c7c9d6; font:italic 21px/1.35 Georgia,serif; text-align:right; }
.student-twin-tabs { display:flex; align-items:center; gap:25px; min-height:48px; margin-bottom:19px; border-bottom:1px solid #292a35; overflow-x:auto; }
.student-twin-tabs button { position:relative; flex:0 0 auto; height:48px; padding:0 15px; border:0; background:transparent; color:#b8bfd0; font:500 15px var(--font-sans); cursor:pointer; transition:color .18s; }
.student-twin-tabs button:hover,.student-twin-tabs button.active { color:#f4efff; }
.student-twin-tabs button.active::after { position:absolute; right:0; bottom:-1px; left:0; height:3px; border-radius:3px 3px 0 0; background:#a52aff; content:''; box-shadow:0 0 12px rgba(165,42,255,.35); }
.student-twin-top-grid { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(320px,.75fr); gap:16px; margin-bottom:16px; }
.student-twin-profile,.student-twin-style,.student-twin-section { min-width:0; border:1px solid #292a34; border-radius:15px; background:linear-gradient(145deg,#0d0e14,#0a0b10); }
.student-twin-profile { display:grid; grid-template-columns:minmax(250px,1.02fr) minmax(270px,.98fr); min-height:382px; overflow:hidden; }
.student-twin-portrait { position:relative; min-height:382px; overflow:hidden; border-right:1px solid rgba(149,55,223,.2); background:radial-gradient(ellipse at 50% 56%,rgba(111,20,180,.19),transparent 68%),#090910; }
.student-twin-portrait > img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; mix-blend-mode:screen; }
.student-twin-traits { display:flex; flex-direction:column; justify-content:center; gap:12px; padding:23px 20px; }
.student-twin-page h2 { margin:0; color:#f4f3f7; font-size:20px; font-weight:700; letter-spacing:-.02em; }
.student-twin-traits > p,.student-twin-style > p,.student-twin-section > p { margin:3px 0 3px; color:#aeb6c9; font-size:14px; line-height:1.5; }
.student-twin-traits article { display:flex; align-items:center; gap:12px; }
.student-twin-traits article > span,.student-twin-suggestion > span { display:grid; width:46px; height:46px; flex:0 0 46px; place-items:center; border:1px solid #30203c; border-radius:12px; background:#181222; color:#c25fff; }
.student-twin-traits article svg { width:21px; height:21px; }
.student-twin-traits strong,.student-twin-growth-row strong,.student-twin-skill-copy strong { display:block; color:#f0eef4; font-size:14px; font-weight:600; }
.student-twin-traits small,.student-twin-growth-row small,.student-twin-skill-copy small { display:block; margin-top:3px; color:#aeb6c9; font-size:12px; line-height:1.4; }
.student-twin-style { display:flex; flex-direction:column; justify-content:center; padding:22px 20px 17px; }
.student-twin-style > p { margin-bottom:15px; }
.student-twin-meter { display:grid; grid-template-columns:minmax(112px,1fr) minmax(75px,1.25fr) 38px; align-items:center; gap:10px; margin-bottom:17px; color:#c6ccdc; font-size:13px; }
.student-twin-meter > div,.student-twin-progress { height:12px; overflow:hidden; border-radius:99px; background:#1a1b25; }
.student-twin-meter > div i,.student-twin-progress i { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#8c20e2,#b22bfa); box-shadow:0 0 12px rgba(145,35,229,.22); }
.student-twin-meter b,.student-twin-skill-row > b { color:#f3f1f6; font-size:13px; font-weight:500; text-align:right; }
.student-twin-suggestion { display:flex; align-items:center; gap:13px; margin-top:4px; padding:12px; border:1px solid rgba(135,54,201,.6); border-radius:13px; background:linear-gradient(110deg,rgba(66,22,91,.3),rgba(15,13,23,.7)); }
.student-twin-suggestion > span { width:50px; height:50px; flex-basis:50px; border:0; background:#20132f; color:#ca68f8; }
.student-twin-suggestion strong { color:#f3eff8; font-size:14px; }
.student-twin-suggestion p { margin:4px 0 0; color:#b8bfd0; font-size:12px; line-height:1.45; }
.student-twin-bottom-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }
.student-twin-section { min-height:250px; padding:19px; }
.student-twin-section-heading { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; }
.student-twin-section-heading > span { display:flex; align-items:center; gap:6px; color:#c7b0e4; font-size:12px; }
.student-twin-skill-row { display:grid; grid-template-columns:38px minmax(80px,1fr) minmax(65px,.8fr) 38px; align-items:center; gap:10px; min-height:48px; border-top:1px solid rgba(255,255,255,.055); }
.student-twin-skill-icon { display:grid; width:34px; height:34px; place-items:center; border-radius:9px; background:#1b1327; color:#c76aff; }
.student-twin-skill-copy { min-width:0; }.student-twin-skill-copy strong { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; }.student-twin-skill-copy small { font-size:11px; }
.student-twin-progress { height:10px; }.student-twin-skill-row > b { font-size:12px; }
.student-twin-practice { grid-column:2 / -1; display:flex; align-items:center; justify-content:flex-end; gap:6px; margin:-6px 0 7px; border:0; background:transparent; color:#c477f3; font-size:12px; cursor:pointer; }
.student-twin-practice:hover { color:#e2b4ff; }
.student-twin-empty-copy { padding:18px 0; color:#9ea6b8; font-size:13px; line-height:1.5; }
.student-twin-empty { display:flex; align-items:center; gap:10px; min-height:100px; color:#aab0c0; font-size:13px; }
.student-twin-growth-row { display:flex; align-items:center; gap:11px; min-height:61px; border-top:1px solid rgba(255,255,255,.055); }
.student-twin-growth-row > span { display:grid; width:38px; height:38px; flex:0 0 38px; place-items:center; border-radius:10px; background:#1b1327; color:#c76aff; }
.student-twin-zero-cta { display:flex; align-items:center; gap:12px; margin-top:15px; padding:16px 18px; border-left:2px solid #8c2ed0; background:linear-gradient(90deg,rgba(85,30,121,.16),transparent); }
.student-twin-zero-cta > div { flex:1; }.student-twin-zero-cta strong,.student-twin-zero-cta span { display:block; }.student-twin-zero-cta strong { color:#f3eff7; font-size:14px; }.student-twin-zero-cta span { margin-top:4px; color:#adb5c7; font-size:12px; }
.student-twin-zero-cta button,.student-twin-misconceptions button { display:flex; align-items:center; justify-content:center; gap:7px; min-height:38px; padding:0 13px; border:1px solid #8030c7; border-radius:9px; background:#6811b2; color:#fff; font-size:12px; cursor:pointer; }
.student-twin-zero-cta button.secondary { border-color:#34323d; background:transparent; color:#d1cdda; }
.student-twin-misconceptions { margin-top:16px; padding:20px; border-top:1px solid #282932; }
.student-twin-misconceptions > p { margin:4px 0 14px; color:#aeb6c9; font-size:13px; }
.student-twin-misconceptions article { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 0; border-top:1px solid rgba(255,255,255,.07); }
.student-twin-misconceptions article strong,.student-twin-misconceptions article small { display:block; }.student-twin-misconceptions article small { margin-top:3px; color:#aeb6c9; font-size:12px; }
@media (max-width:1100px) { .student-twin-top-grid { grid-template-columns:1fr; }.student-twin-bottom-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media (max-width:720px) { .student-twin-heading { flex-direction:column; gap:8px; }.student-twin-heading blockquote { margin:0; text-align:left; font-size:17px; }.student-twin-heading p { font-size:14px; }.student-twin-tabs { gap:3px; }.student-twin-tabs button { padding:0 9px; font-size:13px; }.student-twin-profile { grid-template-columns:1fr; }.student-twin-portrait { min-height:250px; border-right:0; border-bottom:1px solid rgba(149,55,223,.2); }.student-twin-traits { padding:19px 16px; }.student-twin-bottom-grid { grid-template-columns:1fr; }.student-twin-meter { grid-template-columns:minmax(100px,1fr) minmax(60px,1.1fr) 35px; gap:7px; font-size:12px; }.student-twin-section { padding:16px; }.student-twin-zero-cta { align-items:stretch; flex-direction:column; }.student-twin-zero-cta button { width:100%; } }
.progress-dashboard { width: 100%; }
.progress-topbar { margin-bottom: 7px; }
.progress-topbar label { width: min(590px, 77%); }
.progress-heading { align-items: center; }
.progress-heading h1 { font-size: clamp(38px, 4vw, 54px) !important; }
.progress-heading p { color: #b8bfd0 !important; font-size: 15px !important; }
.progress-quote { margin: 0 10px; color: #c6c9d6; font: italic 19px/1.45 Georgia, serif; text-align: right; }
.progress-tabs { margin-top: -8px; }
.progress-time-panel { display: flex; align-items: center; gap: 15px; padding: 20px; border: 1px solid #272833; border-radius: 14px; background: linear-gradient(110deg, #0e0f15, #0a0b10); color: #c589ff; }
.progress-time-panel > div { flex: 1; }
.progress-time-panel strong { color: #f5f2f9; }
.progress-time-panel p { margin-top: 3px; color: #aeb3c2; font-size: 12px; }
.progress-time-panel button { display: inline-flex; align-items: center; gap: 7px; padding: 9px 12px; border: 1px solid #8322d7; border-radius: 9px; background: rgba(112,21,187,.18); color: #d2a0ff; cursor: pointer; }
.progress-dashboard .card-panel { transition: transform .2s, border-color .2s, box-shadow .2s; }
.progress-dashboard .card-panel:hover { border-color: rgba(149,59,232,.4); box-shadow: 0 10px 24px rgba(0,0,0,.2); }
@media (max-width: 760px) {
  .team-detail-grid { grid-template-columns: minmax(0, 1fr); }
  .team-overview-grid { grid-template-columns: minmax(0, 1fr) !important; }
  .team-session-count { display: none; }
  .team-heading > div:last-child { align-self: flex-start; }
  .teacher-header .teacher-tabs { overflow-x: auto; gap: 4px; }
  .teacher-header .teacher-tabs button { flex: 0 0 auto; padding-right: 10px; padding-left: 10px; }
  .progress-quote { display: none; }
  .progress-time-panel { align-items: flex-start; flex-wrap: wrap; }
}
.team-heading h1 span { color: #8d20f2; }
.progress-dashboard { color: #e8e6ef; }
.progress-heading { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin: 5px 0 12px; }
.progress-heading h1 { margin: 5px 0 0; color: #f8f7fb; font-size: clamp(38px, 4vw, 54px); font-weight: 800; letter-spacing: -.045em; line-height: 1.08; }
.progress-heading p { margin-top: 4px; color: #b8bfd0; font-size: 15px; }
.progress-heading blockquote { margin: 0 10px 0 0; color: #c6c9d6; font: italic 19px/1.45 Georgia, serif; text-align: right; }
.progress-eyebrow { color: #b7bfd2; font-size: 11px; font-weight: 700; letter-spacing: .16em; }
.progress-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 13px; }
.progress-metric { display: flex; align-items: flex-start; gap: 14px; min-width: 0; padding: 17px; border: 1px solid #252631; border-radius: 13px; background: linear-gradient(135deg, #0f1017, #0b0c11); transition: transform .2s, border-color .2s, box-shadow .2s; }
.progress-metric:hover { transform: translateY(-3px); border-color: rgba(151,59,232,.5); box-shadow: 0 12px 25px rgba(0,0,0,.26), 0 0 20px rgba(108,24,181,.12); }
.progress-metric > span { display: grid; width: 45px; height: 45px; flex: 0 0 45px; place-items: center; border: 1px solid rgba(164,79,235,.2); border-radius: 11px; background: rgba(106,24,161,.17); color: #c176ff; }
.progress-metric > div { display: flex; min-width: 0; flex-direction: column; gap: 2px; }
.progress-metric small { color: #b3b7c6; font-size: 11px; }
.progress-metric strong { color: #f6f4fa; font-size: 25px; line-height: 1.2; }
.progress-metric em { color: #a0a5b5; font-size: 10px; font-style: normal; }
.progress-overview-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 15px; }
.progress-panel { min-width: 0; padding: 20px; border: 1px solid #252631; border-radius: 14px; background: linear-gradient(135deg, #0e0f15, #0a0b10); }
.progress-panel > header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 17px; }
.progress-panel > header h2 { display: flex; align-items: center; gap: 8px; color: #f5f3f9; font-size: 17px; }
.progress-panel > header h2 svg { color: #c17bff; }
.progress-panel > header p { margin-top: 3px; color: #aeb3c2; font-size: 12px; }
.progress-panel > header > span { color: #aaafbe; font-size: 11px; }
.progress-distribution-body { display: flex; align-items: center; justify-content: space-evenly; gap: 18px; min-height: 165px; }
.progress-donut { display: grid; width: 143px; height: 143px; flex: 0 0 143px; place-items: center; border-radius: 50%; background: conic-gradient(#861bf0 0 var(--progress-value), #282638 var(--progress-value) 100%); box-shadow: 0 0 24px rgba(99,24,182,.15); }
.progress-donut > div { display: flex; width: 105px; height: 105px; flex-direction: column; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.04); border-radius: 50%; background: #0c0d12; }
.progress-donut strong { color: #f6f4fa; font-size: 23px; }
.progress-donut small { color: #aeb3c2; font-size: 10px; }
.progress-legend { display: flex; min-width: 150px; flex: 1; flex-direction: column; gap: 13px; }
.progress-legend p { display: flex; align-items: center; gap: 8px; color: #b9bdca; font-size: 11px; }
.progress-legend p strong { margin-left: auto; color: #f1eff6; }
.progress-legend i { width: 8px; height: 8px; flex: 0 0 8px; border-radius: 50%; background: #7620d5; }
.progress-legend i.is-correct { background: #54d8a4; }
.progress-legend i.is-review { background: #a743ff; }
.progress-legend i.is-neutral { background: #818399; }
.progress-next { display: flex; flex-direction: column; justify-content: center; background: radial-gradient(ellipse at 8% 0%, rgba(104,0,203,.2), transparent 64%), #0d0d14; }
.progress-next h2 { margin-top: 9px; color: #f4f1f8; font-size: 21px; line-height: 1.3; }
.progress-next p { margin-top: 7px; color: #aeb3c2; font-size: 12px; }
.progress-next > div { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 17px; }
.progress-next button, .progress-tab-panel > header > button { display: inline-flex; align-items: center; gap: 7px; padding: 9px 12px; border: 1px solid #7a22c8; border-radius: 9px; background: rgba(103,20,176,.17); color: #d1a0ff; font-size: 11px; cursor: pointer; transition: .2s; }
.progress-next button:last-child { background: linear-gradient(110deg,#7517dc,#530bc0); color: #fff; }
.progress-next button:hover, .progress-tab-panel > header > button:hover { transform: translateY(-2px); box-shadow: 0 7px 19px rgba(108,19,183,.25); }
.progress-activity { margin-top: 0; }
.progress-event-list { display: flex; flex-direction: column; gap: 8px; }
.progress-event { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border: 1px solid #22232d; border-radius: 10px; background: #0b0c11; transition: border-color .2s, transform .2s; }
.progress-event:hover { transform: translateX(2px); border-color: rgba(149,59,232,.4); }
.progress-event > span { display: grid; width: 36px; height: 36px; flex: 0 0 36px; place-items: center; border-radius: 9px; background: rgba(112,26,173,.18); color: #c37eff; }
.progress-event > span.is-correct { background: rgba(26,123,85,.18); color: #67dcae; }
.progress-event > div { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3px; }
.progress-event > div strong { overflow: hidden; color: #f0eef5; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.progress-event > div small { display: flex; align-items: center; gap: 5px; color: #9fa4b3; font-size: 10px; }
.progress-event > em { padding: 3px 8px; border: 1px solid #403047; border-radius: 99px; color: #d2a0ff; font-size: 10px; font-style: normal; }
.progress-event > em.is-correct { border-color: rgba(70,185,140,.3); color: #76dcb5; }
.progress-empty { padding: 28px 16px; border: 1px dashed #30303d; border-radius: 11px; color: #a5aab9; font-size: 12px; text-align: center; }
.progress-evidence-strip { display: flex; align-items: center; gap: 13px; padding: 15px; border: 1px solid #242530; border-radius: 11px; background: #0b0c11; }
.progress-evidence-strip > span { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 10px; background: rgba(110,24,168,.19); color: #c17bff; }
.progress-evidence-strip > div { display: flex; flex: 1; flex-direction: column; gap: 3px; }
.progress-evidence-strip strong { color: #f3f1f7; font-size: 13px; }
.progress-evidence-strip small { color: #a7acbb; font-size: 11px; }
.progress-tab-panel > header > button { flex: 0 0 auto; }
.progress-tab-panel + .progress-activity { margin-top: -10px; }
@media (max-width: 900px) { .progress-metrics { grid-template-columns: repeat(2,minmax(0,1fr)); } }
@media (max-width: 650px) {
  .progress-heading blockquote { display: none; }
  .progress-tabs { gap: 2px; }
  .progress-tabs button { min-width: auto; gap: 6px; padding-right: 8px; padding-left: 8px; font-size: 11px; }
  .progress-tabs button svg { width: 16px; height: 16px; }
  .progress-metrics, .progress-overview-grid { grid-template-columns: minmax(0,1fr); }
  .progress-metric { padding: 13px; }
  .progress-distribution-body { justify-content: flex-start; }
  .progress-donut { width: 118px; height: 118px; flex-basis: 118px; }
  .progress-donut > div { width: 86px; height: 86px; }
}

/* Assessment hub: clear entry points with an evidence backed attempt history. */
.assessment-dashboard { --assessment-purple: #861cf0; width: 100%; max-width: 1220px; margin: 0 auto; color: #e9e7ef; }
.assessment-topbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; margin: -6px 0 35px; }
.assessment-topbar label { display: flex; align-items: center; gap: 14px; width: min(660px, 78%); height: 44px; padding: 0 18px; border: 1px solid #292a35; border-radius: 999px; background: #0c0d13; color: #b9bfd0; transition: border-color .2s, box-shadow .2s; }
.assessment-topbar label:focus-within { border-color: rgba(161,63,255,.7); box-shadow: 0 0 0 3px rgba(132,21,235,.13), 0 0 22px rgba(132,21,235,.12); }
.assessment-topbar input { width: 100%; min-width: 0; border: 0 !important; outline: 0 !important; background: transparent !important; color: #f4f2fa !important; box-shadow: none !important; font: 13px var(--font-sans) !important; }
.assessment-topbar input::placeholder { color: #a5a8b8; }
.assessment-topbar > button { position: relative; display: grid; width: 40px; height: 40px; place-items: center; border: 0; border-radius: 50%; background: transparent; color: #c17aff; cursor: pointer; transition: background .2s, transform .2s; }
.assessment-topbar > button:hover { transform: translateY(-2px); background: rgba(143,47,226,.14); }
.assessment-topbar > button i { position: absolute; top: 6px; right: 7px; width: 8px; height: 8px; border-radius: 50%; background: #9229ff; box-shadow: 0 0 10px #9229ff; }
.assessment-heading { display: flex; align-items: center; justify-content: space-between; gap: 22px; margin-bottom: 21px; }
.assessment-heading > div > span { color: #b7bfd2; font-size: 11px; font-weight: 700; letter-spacing: .16em; }
.assessment-heading h1 { margin: 6px 0 2px; color: #faf9fc; font-size: clamp(38px, 4vw, 52px); font-weight: 800; letter-spacing: -.045em; line-height: 1.08; }
.assessment-heading p { color: #b8bfd0; font-size: 15px; }
.assessment-heading blockquote { margin: 0 10px 0 0; color: #c6c9d6; font: italic 19px/1.4 Georgia, serif; text-align: right; }
.assessment-main-grid { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 20px; align-items: start; }
.assessment-main-column, .assessment-side-column { display: flex; min-width: 0; flex-direction: column; gap: 16px; }
.assessment-tabs { display: flex; align-items: stretch; gap: clamp(12px, 2.7vw, 34px); min-height: 44px; border-bottom: 1px solid #2b2b35; overflow-x: auto; }
.assessment-tabs button { position: relative; display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: center; gap: 9px; min-width: 116px; padding: 8px 15px 12px; border: 0; background: transparent; color: #b8bfd0; font: 500 13px var(--font-sans); cursor: pointer; transition: color .2s, text-shadow .2s; }
.assessment-tabs button::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 4px; border-radius: 4px 4px 0 0; background: linear-gradient(90deg,#7820eb,#bf44ff); content: ''; transform: scaleX(0); transition: transform .22s ease; }
.assessment-tabs button:hover { color: #f6edff; text-shadow: 0 0 14px rgba(179,104,255,.45); }
.assessment-tabs button.is-active { color: #fff; }
.assessment-tabs button.is-active svg { color: #c782ff; }
.assessment-tabs button.is-active::after { transform: scaleX(1); }
.assessment-tabs button small { display: grid; min-width: 18px; height: 18px; place-items: center; border-radius: 99px; background: rgba(128,30,212,.22); color: #d5a4ff; font-size: 10px; }
.assessment-action-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; }
.assessment-action-grid article { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; padding: 16px; border: 1px solid #252631; border-radius: 13px; background: linear-gradient(145deg,#101117,#0b0c11); transition: transform .22s,border-color .22s,box-shadow .22s,background .22s; }
.assessment-action-grid article:hover { transform: translateY(-4px); border-color: rgba(156,67,239,.62); background: linear-gradient(145deg,#14121c,#0c0c13); box-shadow: 0 13px 28px rgba(0,0,0,.3),0 0 22px rgba(108,24,181,.14); }
.assessment-action-grid article > span, .assessment-recommendation-grid button > span { display: grid; width: 45px; height: 45px; place-items: center; border: 1px solid rgba(174,73,245,.16); border-radius: 11px; background: linear-gradient(145deg,rgba(91,23,139,.3),rgba(43,13,75,.34)); color: #c279ff; transition: transform .2s,box-shadow .2s; }
.assessment-action-grid article:hover > span { transform: scale(1.06) rotate(-3deg); box-shadow: 0 0 20px rgba(146,42,226,.23); }
.assessment-action-grid h2 { margin-top: 10px; color: #f3f1f7; font-size: 15px; }
.assessment-action-grid p { min-height: 47px; margin: 5px 0 14px; color: #b0b5c4; font-size: 11px; line-height: 1.55; }
.assessment-action-grid article > button { display: flex; width: 100%; align-items: center; justify-content: center; gap: 7px; min-height: 39px; margin-top: auto; padding: 7px 10px; border: 1px solid #8220e3; border-radius: 9px; background: linear-gradient(110deg,#7415dc,#540bc1); color: #fff; font: 600 11px var(--font-sans); cursor: pointer; transition: transform .2s,box-shadow .2s,filter .2s; }
.assessment-action-grid article > button:hover { transform: translateY(-2px); filter: brightness(1.12); box-shadow: 0 8px 20px rgba(122,22,217,.3); }
.assessment-recent-panel, .assessment-recommendations, .assessment-why { padding: 17px; border: 1px solid #252631; border-radius: 13px; background: linear-gradient(135deg,#0e0f15,#0a0b10); }
.assessment-recent-panel > header, .assessment-recommendations > header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.assessment-recent-panel > header h2, .assessment-recommendations > header h2, .assessment-why h2 { color: #f4f2f8; font-size: 16px; }
.assessment-recent-panel > header p, .assessment-recommendations > header p { margin-top: 2px; color: #aeb3c2; font-size: 11px; }
.assessment-recent-panel > header > button, .assessment-recommendations > header > button { display: inline-flex; align-items: center; gap: 5px; padding: 6px 2px; border: 0; background: transparent; color: #bd6bff; font-size: 11px; cursor: pointer; transition: color .2s,transform .2s; }
.assessment-recent-panel > header > button:hover, .assessment-recommendations > header > button:hover { transform: translateX(2px); color: #e2baff; }
.assessment-attempt-list { display: flex; flex-direction: column; }
.assessment-attempt-list article, .assessment-topic-list article { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 10px 11px; border-top: 1px solid #242530; transition: background .18s; }
.assessment-attempt-list article:hover, .assessment-topic-list article:hover { background: rgba(112,34,172,.08); }
.assessment-attempt-list article > span, .assessment-topic-list article > span { display: grid; width: 36px; height: 36px; flex: 0 0 36px; place-items: center; border: 1px solid rgba(174,73,245,.14); border-radius: 9px; background: rgba(92,24,147,.19); color: #c17bff; }
.assessment-attempt-list article > div, .assessment-topic-list article > div { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3px; }
.assessment-attempt-list strong, .assessment-topic-list strong { overflow: hidden; color: #f1eff6; font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
.assessment-attempt-list small, .assessment-topic-list small { overflow: hidden; color: #a5aabb; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.assessment-attempt-list em { padding: 4px 9px; border: 1px solid rgba(75,201,145,.34); border-radius: 7px; background: rgba(25,113,77,.15); color: #81ddb7; font-size: 11px; font-style: normal; }
.assessment-empty { display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 92px; padding: 20px; color: #a6abba; font-size: 12px; text-align: center; }
.assessment-empty button { display: inline-flex; align-items: center; gap: 5px; padding: 7px 10px; border: 1px solid #7a22c8; border-radius: 8px; background: rgba(103,20,176,.17); color: #d1a0ff; cursor: pointer; }
.assessment-recommendations { margin-top: 0; }
.assessment-recommendation-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
.assessment-recommendation-grid button { display: flex; align-items: center; gap: 11px; min-width: 0; padding: 11px; border: 1px solid #242530; border-radius: 10px; background: #0b0c11; color: #c0c4d1; text-align: left; cursor: pointer; transition: transform .2s,border-color .2s,box-shadow .2s; }
.assessment-recommendation-grid button:hover { transform: translateY(-3px); border-color: rgba(156,67,239,.55); box-shadow: 0 8px 21px rgba(0,0,0,.24),0 0 18px rgba(108,24,181,.1); }
.assessment-recommendation-grid button > span { width: 42px; height: 42px; flex: 0 0 42px; }
.assessment-recommendation-grid button > div { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 3px; }
.assessment-recommendation-grid strong { color: #f1eff6; font-size: 11px; }
.assessment-recommendation-grid small { color: #a9aebd; font-size: 10px; line-height: 1.4; }
.assessment-recommendation-grid button > svg { flex: 0 0 auto; color: #abb1c2; }
.assessment-why { padding: 19px; }
.assessment-why h2 { margin: 0 0 12px; }
.assessment-why article { display: flex; align-items: center; gap: 12px; padding: 10px 0; }
.assessment-why article + article { border-top: 1px solid #20212a; }
.assessment-why article > span { display: grid; width: 45px; height: 45px; flex: 0 0 45px; place-items: center; border-radius: 10px; background: rgba(94,24,150,.2); color: #c176ff; }
.assessment-why article > div { display: flex; flex-direction: column; gap: 3px; }
.assessment-why strong { color: #eeecf3; font-size: 12px; }
.assessment-why small { color: #a9aebd; font-size: 10px; }
.assessment-quote-card { position: relative; display: flex; min-height: 168px; flex-direction: column; justify-content: center; overflow: hidden; padding: 23px; border: 1px solid rgba(113,36,178,.26); border-radius: 13px; background: radial-gradient(ellipse at 90% 100%,rgba(80,12,145,.31),transparent 57%),linear-gradient(145deg,#0e0c17,#0b0b11); color: #d5d2df; font: italic 18px/1.45 Georgia,serif; }
.assessment-quote-card i { display: block; width: 42px; height: 3px; margin-top: 15px; background: #a02cff; box-shadow: 0 0 13px rgba(160,44,255,.4); }
.assessment-runner-shell { width: 100%; max-width: 1000px; margin: 0 auto; }
.assessment-back { display: inline-flex; align-items: center; gap: 7px; margin: 0 0 16px; padding: 8px 11px; border: 1px solid #35323f; border-radius: 8px; background: #0c0c12; color: #cdb5e7; cursor: pointer; transition: .2s; }
.assessment-back:hover { border-color: #8d27da; color: white; transform: translateX(-2px); }
.assessment-practice-panel > header select { max-width: 280px; padding: 9px 12px; border: 1px solid #343440; border-radius: 9px; background: #0b0c11; color: #eeeaf5; }
.assessment-topic-list { display: flex; flex-direction: column; }
.assessment-topic-list article > button { display: inline-flex; align-items: center; gap: 6px; padding: 8px 11px; border: 1px solid #8520e0; border-radius: 8px; background: linear-gradient(110deg,#7415dc,#540bc1); color: white; cursor: pointer; transition: transform .2s,box-shadow .2s; }
.assessment-topic-list article > button:hover { transform: translateY(-2px); box-shadow: 0 7px 18px rgba(122,22,217,.28); }
@media (max-width: 960px) { .assessment-main-grid { grid-template-columns: minmax(0,1fr); } .assessment-side-column { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); } .assessment-quote-card { min-height: 100%; } }
@media (max-width: 680px) { .assessment-heading blockquote { display: none; } .assessment-action-grid, .assessment-recommendation-grid { grid-template-columns: minmax(0,1fr); } .assessment-action-grid p { min-height: 0; } .assessment-side-column { grid-template-columns: minmax(0,1fr); } .assessment-quote-card { min-height: 130px; } .assessment-practice-panel > header { align-items: flex-start; flex-direction: column; } .assessment-practice-panel > header select { width: 100%; max-width: none; } }

/* Keep typography consistent across every screen and calm the assessment palette. */
#root, #root *, .assessment-runner-shell, .assessment-runner-shell * { font-family: var(--font-sans) !important; }
.assessment-dashboard { --assessment-purple: #8061b2; }
.assessment-topbar label { background: #0d0e13; border-color: #2a2b34; }
.assessment-topbar label:focus-within { border-color: rgba(143,119,184,.75); box-shadow: 0 0 0 3px rgba(122,94,168,.12); }
.assessment-topbar > button { color: #b7a5d3; }
.assessment-topbar > button i { background: #8a70b5; box-shadow: 0 0 8px rgba(138,112,181,.55); }
.assessment-tabs button::after { background: #9474c4; }
.assessment-tabs button:hover { color: #e4dcef; text-shadow: none; }
.assessment-tabs button.is-active svg { color: #b9a1dc; }
.assessment-tabs button small { background: rgba(126,97,172,.18); color: #c8b6e1; }
.assessment-action-grid article { background: #0d0e13; border-color: #292a34; }
.assessment-action-grid article:hover { transform: translateY(-2px); border-color: rgba(142,119,179,.58); background: #111116; box-shadow: 0 9px 23px rgba(0,0,0,.24); }
.assessment-action-grid article > span, .assessment-recommendation-grid button > span { border-color: rgba(158,139,190,.16); background: #191621; color: #b6a0d5; }
.assessment-action-grid article:hover > span { transform: translateY(-1px); box-shadow: none; }
.assessment-action-grid article > button { border-color: #68528d; background: #59467a; }
.assessment-action-grid article > button:hover { transform: translateY(-1px); filter: brightness(1.09); box-shadow: 0 5px 14px rgba(61,45,86,.32); }
.assessment-recent-panel, .assessment-recommendations, .assessment-why { background: #0d0e13; border-color: #292a34; }
.assessment-recent-panel > header > button, .assessment-recommendations > header > button { color: #b7a0d4; }
.assessment-recent-panel > header > button:hover, .assessment-recommendations > header > button:hover { color: #e0d5ed; }
.assessment-attempt-list article > span, .assessment-topic-list article > span { border-color: rgba(158,139,190,.16); background: #181620; color: #b7a2d6; }
.assessment-attempt-list article > span:has(svg.lucide-circle-check) { color: #82bbae; }
.assessment-attempt-list em { border-color: rgba(103,155,130,.34); background: rgba(39,94,66,.14); color: #9bceb3; }
.assessment-empty button, .assessment-topic-list article > button { border-color: #68528d; background: #59467a; color: #f4f0f8; }
.assessment-recommendation-grid button { background: #0b0c11; border-color: #282932; }
.assessment-recommendation-grid button:hover { transform: translateY(-2px); border-color: rgba(142,119,179,.48); box-shadow: 0 7px 17px rgba(0,0,0,.22); }
.assessment-why article > span { background: #191621; color: #b6a0d5; }
.assessment-quote-card { border-color: #302b39; background: #101015; color: #d2ccd9; font-style: normal; }
.assessment-quote-card i { background: #9071bd; box-shadow: none; }
.assessment-back { border-color: #34323a; background: #101015; color: #c7bbd5; }
.assessment-back:hover { border-color: #8c75ae; }
.assessment-practice-panel > header select { border-color: #34343d; background: #101116; }

/* Login page layout and brand scale from the supplied sign-in reference. */
.login-page { min-height: 100vh; padding: 26px clamp(22px,4.5vw,70px) 34px !important; background: #050507 !important; }
.login-header { max-width: 1400px !important; padding-top: 10px !important; }
.login-page .knowledge-twin-logo { width: min(38vw, 500px) !important; max-width: 500px !important; }
.login-page .knowledge-twin-logo .shared-wordmark { display: block !important; width: 100% !important; max-width: 500px !important; height: 112px !important; object-fit: cover !important; object-position: center !important; mix-blend-mode: screen; }
.login-create-account { min-width: 196px; padding: 12px 22px !important; border: 1px solid #7653a7 !important; border-radius: 12px !important; background: #0c0b10 !important; color: #f2eff7 !important; box-shadow: none !important; }
.login-create-account:hover { border-color: #ad8bd1 !important; background: #15121b !important; box-shadow: 0 0 20px rgba(114,79,151,.15) !important; }
.login-main { max-width: 1400px !important; grid-template-columns: repeat(12,minmax(0,1fr)); gap: clamp(30px,5vw,76px) !important; padding-top: 12px !important; padding-bottom: 12px !important; }
.login-art-column { grid-column: span 6 / span 6; min-height: min(72vh,740px) !important; }
.login-art-stage { max-width: 700px !important; height: min(72vh,740px) !important; }
.login-illustration { object-fit: contain !important; filter: drop-shadow(0 0 24px rgba(104,0,203,.27)) !important; }
.login-art-note { position: absolute; z-index: 2; display: flex; align-items: center; gap: 11px; min-width: 142px; padding: 11px 13px; border: 1px solid rgba(131,80,188,.53); border-radius: 10px; background: rgba(9,8,14,.9); color: #c7a5eb; box-shadow: 0 9px 25px rgba(0,0,0,.35); font-size: 12px; line-height: 1.35; transition: transform .22s,border-color .22s,background .22s; }
.login-art-note:hover { transform: translateY(-3px); border-color: rgba(186,147,220,.76); background: #111018; }
.login-art-note svg { flex: 0 0 auto; color: #b17ce0; }
.art-note-one { top: 17%; left: 20%; }
.art-note-two { top: 39%; left: 7%; }
.art-note-three { top: 23%; right: 5%; }
.art-note-four { top: 55%; right: 1%; }
.login-form-column { grid-column: span 6 / span 6; justify-content: flex-end !important; }
.login-card { max-width: 596px !important; padding: clamp(30px,3.3vw,52px) !important; border: 1px solid rgba(130,77,183,.72) !important; border-radius: 20px !important; background: rgba(8,8,12,.94) !important; backdrop-filter: blur(18px); box-shadow: 0 22px 60px rgba(0,0,0,.55), 0 0 26px rgba(83,49,119,.12), inset 0 1px rgba(255,255,255,.035) !important; }
.login-card h1 { margin-bottom: 8px !important; font-size: clamp(29px,2.8vw,38px) !important; }
.login-card h1 span { background-image: linear-gradient(110deg,#a85be1,#7535c1) !important; filter: none !important; }
.login-card form { gap: 15px !important; }
.login-card form > div > div { min-height: 54px; border-color: rgba(160,157,174,.31) !important; background: #08080b !important; }
.login-card form > div > div:focus-within { border-color: rgba(156,115,196,.82) !important; box-shadow: 0 0 0 3px rgba(128,89,164,.12); }
.login-card form > button[type="submit"] { min-height: 54px; border-color: rgba(163,126,201,.55) !important; background: linear-gradient(105deg,#7738bd,#652ea8) !important; box-shadow: 0 7px 20px rgba(83,49,119,.22) !important; }
.login-card form > button[type="submit"]:hover { filter: brightness(1.08); box-shadow: 0 10px 25px rgba(83,49,119,.3) !important; }
.login-card .relative.z-10.grid.grid-cols-2 { border-radius: 12px !important; }
.login-card .relative.z-10.grid.grid-cols-2 button { min-height: 48px; border-radius: 10px !important; }
.login-card .relative.z-10.grid.grid-cols-2 button[style*="rgb(104, 0, 203)"] { background: #7435b2 !important; border-color: rgba(190,156,219,.37) !important; box-shadow: 0 4px 13px rgba(83,49,119,.28) !important; }
.login-card .text-purple-300 { color: #b795d5 !important; }
.login-card .text-purple-300:hover { color: #e0c8f2 !important; }
.login-card .flex.items-center.justify-center.gap-3\.5 button { width: 54px; height: 54px; border-radius: 12px !important; border-color: rgba(151,146,163,.24) !important; background: #09090d !important; }
.login-card .flex.items-center.justify-center.gap-3\.5 button:hover { transform: translateY(-2px); border-color: rgba(165,133,196,.65) !important; }
.login-card .relative.flex.items-center.justify-center.my-6 span { background: #08080c !important; border: 0 !important; }
.login-card .relative.flex.items-center.justify-center.my-6 { margin-top: 24px !important; margin-bottom: 24px !important; }
.login-card .text-center.mt-7 { margin-top: 26px !important; }
.login-runner { font-family: var(--font-sans) !important; }
@media (max-width: 1023px) {
  .login-page { justify-content: flex-start !important; }
  .login-main { grid-template-columns: minmax(0,1fr) !important; gap: 14px !important; margin-top: 18px !important; }
  .login-art-column { grid-column: 1; min-height: 250px !important; }
  .login-art-stage { height: 310px !important; max-width: 420px !important; }
  .login-form-column { grid-column: 1; justify-content: center !important; }
  .login-card { max-width: 560px !important; }
  .login-page .knowledge-twin-logo { width: min(48vw,330px) !important; }
  .login-page .knowledge-twin-logo .shared-wordmark { height: 78px !important; }
  .login-art-note { min-width: 118px; padding: 8px 9px; font-size: 10px; }
}
@media (max-width: 600px) {
  .login-page { padding: 17px 16px 24px !important; }
  .login-page .knowledge-twin-logo { width: min(57vw,255px) !important; }
  .login-page .knowledge-twin-logo .shared-wordmark { height: 65px !important; }
  .login-create-account { min-width: 0; padding: 9px 12px !important; font-size: 11px !important; }
  .login-header > div:last-child { gap: 8px !important; }
  .login-art-column { min-height: 160px !important; }
  .login-art-stage { height: 205px !important; }
  .login-art-note { display: none; }
  .login-card { padding: 23px 18px !important; border-radius: 16px !important; }
  .login-card h1 { font-size: 29px !important; }
  .login-card .text-center.mt-7 { margin-top: 19px !important; }
}

/* Keep the desktop sign-in composition inside the viewport instead of page-scrolling. */
@media (min-width: 1024px) {
  .login-page { height: 100svh; min-height: 640px; max-height: 100svh; overflow: hidden !important; background: #111216 !important; }
  .login-header { flex: 0 0 auto; }
  .login-main { flex: 1 1 auto; height: calc(100svh - 180px); min-height: 0; margin: 8px auto !important; align-items: center; }
  .login-art-column, .login-art-stage { min-height: 0 !important; height: 100% !important; max-height: 100%; }
  .login-card { max-height: calc(100svh - 180px); overflow-y: auto !important; scrollbar-width: thin; scrollbar-color: #57515f #18191e; }
}
.login-page { background: #111216 !important; color: #ecebf0 !important; }
.login-page .login-card { background: #17181d !important; border-color: #4a4651 !important; box-shadow: 0 20px 48px rgba(0,0,0,.32), inset 0 1px rgba(255,255,255,.035) !important; }
.login-page .login-card > div:first-child { background: linear-gradient(90deg,transparent,rgba(177,163,190,.26),transparent) !important; }
.login-page .login-card form > div > div { background: #111216 !important; border-color: #44434a !important; }
.login-page .login-card form > div > div:focus-within { border-color: #958a9f !important; box-shadow: 0 0 0 3px rgba(156,142,167,.1) !important; }
.login-page .login-card form > button[type="submit"] { background: linear-gradient(105deg,#73588b,#665477) !important; border-color: #9584a5 !important; box-shadow: 0 6px 18px rgba(67,53,79,.22) !important; }
.login-page .login-card form > button[type="submit"]:hover { filter: brightness(1.1); box-shadow: 0 8px 20px rgba(67,53,79,.28) !important; }
.login-page .login-card .relative.z-10.grid.grid-cols-2 { background: #111216 !important; border-color: #424149 !important; }
.login-page .login-card .relative.z-10.grid.grid-cols-2 button[style*="rgb(104, 0, 203)"] { background: #665774 !important; border-color: #93839f !important; box-shadow: 0 3px 10px rgba(68,55,79,.24) !important; }
.login-page .login-create-account { background: #17181d !important; border-color: #71697b !important; }
.login-page .login-create-account:hover { background: #202127 !important; border-color: #a99eb3 !important; box-shadow: none !important; }
.login-page .login-art-note { border-color: #4b4653; background: rgba(18,18,23,.94); color: #c6bdcf; box-shadow: 0 7px 18px rgba(0,0,0,.28); }
.login-page .login-art-note svg { color: #a99bb7; }
.login-page .login-art-note:hover { border-color: #81778a; background: #1b1c21; }
.login-page .login-illustration { filter: grayscale(.32) drop-shadow(0 0 20px rgba(115,93,133,.2)) !important; }
.login-page .login-card .relative.flex.items-center.justify-center.my-6 span { background: #17181d !important; }
.login-page .login-card .flex.items-center.justify-center.gap-3\.5 button { background: #14151a !important; border-color: #3e3d45 !important; }
.login-page .login-card .flex.items-center.justify-center.gap-3\.5 button:hover { border-color: #83798c !important; }
.login-page .login-card .text-purple-300 { color: #b5a9c0 !important; }
.login-page .login-card .text-purple-300:hover { color: #ded5e5 !important; }
@media (max-height: 820px) and (min-width: 1024px) {
  .login-page { padding-top: 14px !important; padding-bottom: 14px !important; }
  .login-page .knowledge-twin-logo .shared-wordmark { height: 82px !important; }
  .login-main { height: calc(100svh - 130px); }
  .login-card { max-height: calc(100svh - 130px); padding: 24px 34px !important; }
  .login-card .text-center.mb-7 { margin-bottom: 17px !important; }
  .login-card form { gap: 10px !important; }
  .login-card .relative.z-10.grid.grid-cols-2 { margin-bottom: 16px !important; }
  .login-card .relative.flex.items-center.justify-center.my-6 { margin-top: 14px !important; margin-bottom: 14px !important; }
  .login-card .text-center.mt-7 { margin-top: 15px !important; }
}
@media (max-width: 1023px) {
  .login-page { height: auto; max-height: none; min-height: 100svh; overflow-y: auto !important; background: #111216 !important; }
  .login-main { height: auto; min-height: 0; margin-top: 18px !important; margin-bottom: 12px !important; }
}

/* Keep the gray treatment on the study artwork only; retain the site’s black and violet identity. */
.login-page, .login-page[style] { background: #050507 !important; }
.login-page .login-card { background: rgba(11,11,16,.96) !important; border-color: rgba(104,0,203,.46) !important; box-shadow: 0 20px 52px rgba(0,0,0,.5),0 0 20px rgba(104,0,203,.08),inset 0 1px rgba(255,255,255,.035) !important; }
.login-page .login-card form > div > div { background: #08080c !important; border-color: rgba(255,255,255,.14) !important; }
.login-page .login-card form > div > div:focus-within { border-color: rgba(168,85,247,.7) !important; box-shadow: 0 0 0 3px rgba(132,21,235,.12) !important; }
.login-page .login-card form > button[type="submit"] { background: linear-gradient(105deg,#7200dc,#851be7) !important; border-color: rgba(183,130,231,.48) !important; box-shadow: 0 7px 20px rgba(104,0,203,.22) !important; }
.login-page .login-card form > button[type="submit"]:hover { box-shadow: 0 9px 24px rgba(104,0,203,.32) !important; }
.login-page .login-card .relative.z-10.grid.grid-cols-2 { background: #08080c !important; border-color: rgba(255,255,255,.1) !important; }
.login-page .login-card .relative.z-10.grid.grid-cols-2 button[style*="rgb(104, 0, 203)"] { background: #6800cb !important; border-color: rgba(215,186,255,.3) !important; box-shadow: 0 4px 14px rgba(104,0,203,.26) !important; }
.login-page .login-create-account { background: #111116 !important; border-color: rgba(147,51,234,.56) !important; }
.login-page .login-create-account:hover { background: #19151f !important; border-color: rgba(192,132,252,.8) !important; }
.login-page .login-art-note { border-color: rgba(135,75,192,.48); background: rgba(7,7,12,.94); color: #c8b4df; }
.login-page .login-art-note svg { color: #b56bfa; }
.login-page .login-art-note:hover { border-color: rgba(192,132,252,.75); background: #0e0b14; }
.login-page .login-illustration { filter: grayscale(.72) contrast(1.04) drop-shadow(0 0 18px rgba(146,127,161,.17)) !important; }
.login-page .knowledge-twin-logo { filter: none !important; transform: none !important; background: transparent !important; isolation: auto !important; }
.login-page .knowledge-twin-logo .shared-wordmark { mix-blend-mode: screen !important; filter: none !important; }
.login-page .knowledge-twin-logo:hover { filter: none !important; transform: none !important; }
.login-page .login-art-note { animation: login-note-float 6.2s ease-in-out infinite; will-change: transform; }
.login-page .art-note-two { animation-delay: -1.7s; animation-duration: 6.8s; }
.login-page .art-note-three { animation-delay: -3.2s; animation-duration: 6.5s; }
.login-page .art-note-four { animation-delay: -4.4s; animation-duration: 7.1s; }
@keyframes login-note-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
@media (prefers-reduced-motion: reduce) { .login-page .login-art-note { animation: none !important; } }
@media (min-width: 1024px) {
  .login-page { background: #050507 !important; }
  .login-card { overflow-y: hidden !important; }
  .login-main { height: calc(100svh - 156px); margin-top: 8px !important; margin-bottom: 8px !important; }
  .login-art-column, .login-art-stage { height: 100% !important; }
  .login-card { max-height: calc(100svh - 156px); padding: 28px 40px !important; }
  .login-card .text-center.mb-7 { margin-bottom: 17px !important; }
  .login-card h1 { font-size: clamp(29px,2.6vw,36px) !important; }
  .login-card .relative.z-10.grid.grid-cols-2 { margin-bottom: 16px !important; padding: 3px !important; }
  .login-card .relative.z-10.grid.grid-cols-2 button { min-height: 43px; padding-top: 7px !important; padding-bottom: 7px !important; }
  .login-card form { gap: 9px !important; }
  .login-card form > div > div { min-height: 47px; }
  .login-card form > div > div input { padding-top: 11px !important; padding-bottom: 11px !important; }
  .login-card form > button[type="submit"] { min-height: 47px; padding-top: 9px !important; padding-bottom: 9px !important; }
  .login-card .relative.flex.items-center.justify-center.my-6 { margin-top: 13px !important; margin-bottom: 13px !important; }
  .login-card .flex.items-center.justify-center.gap-3\.5 button { width: 46px; height: 46px; }
  .login-card .text-center.mt-7 { margin-top: 14px !important; }
  .login-page .knowledge-twin-logo .shared-wordmark { height: 90px !important; }
}
@media (max-height: 950px) and (min-width: 1024px) {
  .login-page { padding-top: 10px !important; padding-bottom: 10px !important; }
  .login-main { height: calc(100svh - 136px); }
  .login-card { max-height: calc(100svh - 136px); padding: 22px 36px !important; }
  .login-card .text-center.mb-7 { margin-bottom: 12px !important; }
  .login-card .relative.z-10.grid.grid-cols-2 { margin-bottom: 11px !important; }
  .login-card .relative.z-10.grid.grid-cols-2 button { min-height: 39px; }
  .login-card form { gap: 6px !important; }
  .login-card form > div > div { min-height: 43px; }
  .login-card form > div > div input { padding-top: 9px !important; padding-bottom: 9px !important; }
  .login-card form > button[type="submit"] { min-height: 43px; }
  .login-card .relative.flex.items-center.justify-center.my-6 { margin-top: 9px !important; margin-bottom: 9px !important; }
  .login-card .flex.items-center.justify-center.gap-3\.5 button { width: 42px; height: 42px; }
  .login-card .text-center.mt-7 { margin-top: 10px !important; }
  .login-page .knowledge-twin-logo .shared-wordmark { height: 72px !important; }
}
@media (max-width: 1023px) {
  .login-page { background: #050507 !important; }
  .login-main { height: auto; }
  .login-card { overflow: visible !important; }
}

/* Home dashboard proportions aligned to the supplied desktop reference. */
.learning-layout { grid-template-columns: minmax(0, 1fr) 320px; gap: 18px; }
.continue-card { min-height: 298px; }
.continue-copy { width: 66%; padding: 25px 28px; }
.continue-art { width: 49%; background-position: center 38%; opacity: .86; }
.learning-primary { background: linear-gradient(105deg, #7314dd, #5724bb); border-color: #7544bb; box-shadow: 0 4px 14px rgba(82, 49, 132, .22); }
.learning-primary:hover { transform: translateY(-1px); filter: brightness(1.08); box-shadow: 0 7px 18px rgba(82,49,132,.28); }
.learning-link { color: #b89bd8; }
.learning-link:hover { color: #e0d2f0; }
.evidence-card:hover, .recommendation-tile:hover, .quick-actions-card button:hover { transform: translateY(-2px); border-color: rgba(148,124,181,.42); box-shadow: 0 8px 22px rgba(0,0,0,.2); }
.evidence-card strong { color: #b89bd8; }
.continue-book-icon, .evidence-icon { border-color: rgba(153,129,188,.18); background: #191621; color: #b59bd2; }
.focus-donut { background: conic-gradient(#825db7 var(--focus-value), #292732 var(--focus-value)); }
.focus-donut strong { color: #c2a6e2; }
.focus-dot { background: #8b6eb3; }
.focus-dot.violet { background: #6e608a; }
.learning-quote-card { background: #0d0e13; }
.learning-quote-card span, .learning-promo-card i { background-color: #987bbd; }
.learning-promo-card { background: radial-gradient(ellipse at 80% 120%,rgba(91,72,124,.26),transparent 58%),#0d0e13; border-color: #302b39; }
@media (max-width: 760px) { .learning-layout { grid-template-columns: minmax(0, 1fr); } .continue-copy { width: 100%; } }

/* Login form alignment and restrained grayscale artwork treatment. */
.login-page .login-field {
  position: relative;
  width: 100%;
  min-height: 54px;
  overflow: hidden;
  border-radius: 12px !important;
  background: #0b0b10 !important;
  border: 1px solid rgba(184, 177, 196, .24) !important;
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, .28) !important;
}
.login-page .login-field:focus-within {
  border-color: rgba(158, 102, 220, .78) !important;
  box-shadow: 0 0 0 3px rgba(128, 53, 205, .12), inset 0 1px 2px rgba(0, 0, 0, .28) !important;
}
.login-page .login-field-icon {
  left: 16px !important;
  z-index: 2;
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
}
.login-page .login-field-input {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 0 48px 0 50px !important;
  border: 0 !important;
  border-radius: inherit !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: 0 !important;
  color: #f2f0f5 !important;
  line-height: 1.4;
}
.login-page .login-field-input::placeholder { color: #85818e !important; opacity: 1; }
.login-page .login-field > input:not(.login-field-input) {
  width: 100%;
  min-width: 0;
  min-height: 52px;
  padding: 0 16px !important;
  border: 0 !important;
  border-radius: inherit !important;
  background: transparent !important;
  box-shadow: none !important;
  outline: 0 !important;
  color: #f2f0f5 !important;
}
.login-page .login-password-toggle {
  right: 10px !important;
  z-index: 2;
  display: grid;
  width: 34px;
  height: 34px;
  padding: 0 !important;
  place-items: center;
}
.login-page .login-submit {
  min-height: 52px;
  padding: 12px 22px !important;
  border-radius: 12px !important;
  line-height: 1.2;
  letter-spacing: .01em;
}
.login-page .login-social-divider {
  margin: 22px 0 18px !important;
}
.login-page .login-social-divider span {
  padding: 0 14px !important;
  border: 0 !important;
  background: #0b0b10 !important;
  white-space: nowrap;
}
.login-page .login-social-providers {
  gap: 22px !important;
  margin: 0 auto;
}
.login-page .login-social-providers > button {
  width: 50px !important;
  height: 50px !important;
  flex: 0 0 50px;
  border-radius: 13px !important;
}
.login-page .login-illustration {
  opacity: .82 !important;
  filter: grayscale(1) brightness(.9) contrast(.94) drop-shadow(0 0 16px rgba(170, 170, 180, .13)) !important;
  mix-blend-mode: screen;
  -webkit-mask-image: radial-gradient(ellipse 78% 76% at 50% 50%, #000 60%, transparent 100%) !important;
  mask-image: radial-gradient(ellipse 78% 76% at 50% 50%, #000 60%, transparent 100%) !important;
}
@media (max-width: 1023px) {
  .login-page .login-social-divider { margin: 20px 0 16px !important; }
  .login-page .login-social-providers { gap: 20px !important; }
}
@media (max-height: 950px) and (min-width: 1024px) {
  .login-page .login-social-divider { margin: 13px 0 12px !important; }
  .login-page .login-social-providers { gap: 18px !important; }
  .login-page .login-social-providers > button { width: 46px !important; height: 46px !important; flex-basis: 46px; }
}

/* Use a still desk-study illustration in the home dashboard's continue-learning card. */
.continue-art {
  background: none !important;
  object-fit: cover;
  object-position: center 42%;
  filter: brightness(.88) contrast(1.02);
  mix-blend-mode: screen;
  opacity: .9 !important;
  -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 27%, #000 100%);
  mask-image: linear-gradient(90deg, transparent 0%, #000 27%, #000 100%);
}

/* Keep the hero video at its native 16:9 ratio and use the available width. */
.landing-hero { width: min(1440px, calc(100% - 80px)); grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 24px; padding: 24px 0; }
.landing-art-wrap { width: 100%; aspect-ratio: 16 / 9; }
.landing-art.landing-video { width: 100%; height: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center; }
.landing-copy { padding: 0; }
@media (max-width: 1200px) and (min-width: 901px) {
  .landing-hero { width: calc(100% - 64px); gap: 20px; }
  .landing-title { font-size: clamp(32px, 3.6vw, 43px); }
}
@media (max-width: 900px) {
  .landing-hero { width: min(640px, calc(100% - 40px)); min-height: auto; grid-template-columns: 1fr; gap: 26px; padding: 36px 0 56px; }
  .landing-art-wrap { width: 100%; aspect-ratio: 16 / 9; }
  .landing-copy { max-width: 620px; margin: 0 auto; }
}

/* Full-bleed black canvas: no outer frame or gray side gutters. */
.landing-viewport { padding: 0 !important; background: #050505 !important; }
.landing-frame { min-height: 100vh; border: 0 !important; background: #050505 !important; }
.landing-header { padding-left: max(24px, calc((100% - 1760px) / 2)); padding-right: max(32px, calc((100% - 1760px) / 2)); }
.landing-section, .landing-outcomes-section { border-color: #17151b; }
.landing-frame, .landing-frame * { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important; }
.landing-title, .landing-section-heading h2, .landing-outcomes-copy h2, .landing-info-card h3, .landing-bottom-cta h2 { font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important; }
.landing-section-heading h2, .landing-outcomes-copy h2, .landing-bottom-cta h2 { font-size: clamp(34px, 4.15vw, 48px); font-weight: 800 !important; line-height: 1.16; letter-spacing: -.045em; }
.landing-info-card h3 { font-weight: 700 !important; letter-spacing: -.025em; }
.landing-art.landing-video { transform: scale(1.08); transform-origin: center; }
.landing-art-wrap { position: relative; }
.landing-art-wrap::after {
  content: '';
  position: absolute;
  z-index: 3;
  right: 0;
  bottom: 0;
  width: clamp(54px, 7vw, 112px);
  aspect-ratio: 1;
  background: #050505;
  pointer-events: none;
}

@media (max-width: 760px) {
  .landing-header { padding-left: 12px; padding-right: 12px; }
}

